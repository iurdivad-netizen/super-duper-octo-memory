//@version=6
// ─────────────────────────────────────────────────────────────────────────────
// XAUUSD — EMA 20/50 CROSSOVER + RETEST  (15-minute)
//
// The setup, exactly as specified:
//
//   LONG   1. the 20 EMA crosses ABOVE the 50 EMA            -> setup is armed
//          2. price pulls away from the 20 EMA, then comes
//             back and TOUCHES it                            -> retest
//          3. entry on that retest
//          4. stop loss at the 50 EMA
//          5. take profit = 2.5 x the stop distance
//
//   SHORT  the exact mirror (20 EMA crosses below the 50 EMA, retest from
//          underneath, stop at the 50 EMA above). Shorts can be switched off
//          with "Trade direction" if only the long side is wanted.
//
// Design notes that matter for the backtest being honest:
//
//   * A cross only ARMS the setup. Nothing is bought on the cross bar itself.
//     The trade is taken on the retest, and the setup dies if the retest never
//     comes (bar limit), if the EMAs cross back, or if price closes through the
//     50 EMA — i.e. the premise is gone.
//
//   * "Touch" is a wick touch: the bar's low reaches the 20 EMA (longs). By
//     default the bar must also CLOSE back above the 20 EMA, which is what
//     makes it a retest and not a breakdown. That is the "Close back above /
//     below the 20 EMA" entry mode.
//
//   * The pull-away requirement (ATR based) stops the bar right after the cross
//     from counting as its own retest — right after a cross price is still
//     sitting on both EMAs, so without it every cross would fire instantly.
//
//   * Stop and target are placed as REAL bracket orders (strategy.exit with
//     stop= and limit=), sized off the ACTUAL fill price, not off the signal
//     bar's close. A bar that trades through the stop and closes back inside it
//     is therefore a loss here, as it would be in the market.
//
//   * Orders are created on a confirmed bar close and fill at the next bar's
//     open (process_orders_on_close = false). Nothing repaints.
//
// Intended chart timeframe: 15 minutes. The script warns on the dashboard if it
// is loaded on anything else — the EMAs are read from the chart timeframe, so a
// different chart timeframe is a different system.
//
// XAUUSD note: set a realistic commission/slippage in the Properties tab before
// trusting any equity curve — gold's spread is a meaningful share of a 15-minute
// EMA stop. Defaults here are zero so the raw signal quality is visible first.
//
// No license. Free and open source.
// ─────────────────────────────────────────────────────────────────────────────

strategy("XAUUSD EMA 20/50 Crossover + Retest", shorttitle = "XAU 20/50 RT",
     overlay              = true,
     currency             = currency.NONE,
     initial_capital      = 10000,
     default_qty_type     = strategy.fixed,
     default_qty_value    = 1,
     pyramiding           = 0,
     calc_on_every_tick   = false,
     process_orders_on_close = false,
     commission_type      = strategy.commission.percent,
     commission_value     = 0.0,
     slippage             = 0,
     max_labels_count     = 500,
     max_lines_count      = 500)

// ═════════════════════════════════════════════════════════════════════════════
// GROUPS
// ═════════════════════════════════════════════════════════════════════════════
grpSig   = "1 · Signal — EMAs & retest"
grpEntry = "2 · Entry model"
grpRisk  = "3 · Stop loss & take profit"
grpFilt  = "4 · Filters"
grpSize  = "5 · Position sizing"
grpDisp  = "6 · Display"

// ═════════════════════════════════════════════════════════════════════════════
// MODE CONSTANTS
// ═════════════════════════════════════════════════════════════════════════════
EM_CONF  = "Close back above / below the 20 EMA (confirmation)"
EM_TOUCH = "Touch of the 20 EMA (no confirmation)"
EM_LIMIT = "Resting limit order at the 20 EMA"

DIR_BOTH  = "Both"
DIR_LONG  = "Long only"
DIR_SHORT = "Short only"

SZ_FIXED = "Fixed quantity"
SZ_RISK  = "Risk % of equity"

// ═════════════════════════════════════════════════════════════════════════════
// INPUTS — SIGNAL
// ═════════════════════════════════════════════════════════════════════════════
iFastLen  = input.int(20, "Fast EMA length", minval = 1, group = grpSig)
iSlowLen  = input.int(50, "Slow EMA length", minval = 2, group = grpSig)
iSrc      = input.source(close, "EMA source", group = grpSig)

iMinBars  = input.int(1, "Minimum bars between the cross and the retest", minval = 0, maxval = 100,
     group = grpSig,
     tooltip = "The cross bar itself is normally sitting on both EMAs. 1 means the retest can be the " +
               "very next bar, but never the cross bar.")
iMaxBars  = input.int(40, "Retest must happen within N bars (0 = no limit)", minval = 0, maxval = 1000,
     group = grpSig,
     tooltip = "On 15m, 40 bars is ten hours. If price has not come back to the 20 EMA by then the " +
               "cross is stale and the setup is dropped.")

iAtrLen   = input.int(14, "ATR length (pull-away measure)", minval = 1, group = grpSig)
iPullMult = input.float(0.30, "Required pull-away before a touch counts (x ATR)", minval = 0.0, step = 0.05,
     group = grpSig,
     tooltip = "Price must first travel this far away from the 20 EMA after the cross. Without it, the " +
               "bars immediately after a cross count as their own retest. 0 disables the requirement.")
iTouchBuf = input.float(0.0, "Touch tolerance (price points)", minval = 0.0, step = 0.1, group = grpSig,
     tooltip = "How close to the 20 EMA counts as a touch. 0 = the wick must actually reach it. " +
               "On XAUUSD, 0.2 - 0.5 loosens it by 20-50 cents.")

iInvalidSlow = input.bool(true, "Drop the setup if a bar closes through the 50 EMA", group = grpSig,
     tooltip = "Longs: a close below the 50 EMA cancels the armed setup. The retest premise is gone.")

// ═════════════════════════════════════════════════════════════════════════════
// INPUTS — ENTRY MODEL
// ═════════════════════════════════════════════════════════════════════════════
iEntryMode = input.string(EM_CONF, "Entry trigger", options = [EM_CONF, EM_TOUCH, EM_LIMIT], group = grpEntry,
     tooltip = "Confirmation : the touching bar must close back on the right side of the 20 EMA. " +
               "Entry at the next bar's open.\n" +
               "Touch : enter as soon as a bar wicks into the 20 EMA, no close filter.\n" +
               "Limit : rest a limit order at the 20 EMA while the setup is armed — best fill, but it " +
               "also fills on the moves that keep going.")
iDir       = input.string(DIR_BOTH, "Trade direction", options = [DIR_BOTH, DIR_LONG, DIR_SHORT], group = grpEntry)
iRearm     = input.bool(false, "Allow a new trade on every later retest of the same cross", group = grpEntry,
     tooltip = "OFF (default): one trade per cross. Once the retest trade is taken, the setup is spent " +
               "and the script waits for the next 20/50 cross.\n" +
               "ON: after the trade closes, another touch of the 20 EMA re-enters while the EMAs stay " +
               "crossed the same way.")
iConfirmed = input.bool(true, "Signals on confirmed bars only", group = grpEntry,
     tooltip = "Keep ON. Matters only if 'Recalculate on every tick' is enabled in Properties.")

// ═════════════════════════════════════════════════════════════════════════════
// INPUTS — RISK
// ═════════════════════════════════════════════════════════════════════════════
iRR       = input.float(2.5, "Take profit (x the stop distance)", minval = 0.1, step = 0.1, group = grpRisk)
iSlBuf    = input.float(0.0, "Stop buffer beyond the 50 EMA (price points)", minval = 0.0, step = 0.1,
     group = grpRisk,
     tooltip = "Pushes the stop past the 50 EMA so it is not hit by a one-tick poke. On XAUUSD, " +
               "0.5 - 1.5 is a typical buffer.")
iMinStop  = input.float(0.5, "Minimum stop distance (price points)", minval = 0.0, step = 0.1, group = grpRisk,
     tooltip = "Skip the trade if the 50 EMA is this close to price. A microscopic stop is a coin flip " +
               "against the spread.")
iMaxStop  = input.float(0.0, "Maximum stop distance (price points, 0 = no limit)", minval = 0.0, step = 0.5,
     group = grpRisk,
     tooltip = "Skip the trade when the EMAs are stretched far apart and the 50 EMA stop would be huge.")
iTrailSlow = input.bool(false, "Trail the stop with the 50 EMA", group = grpRisk,
     tooltip = "OFF (default, and what was asked for): the stop stays where the 50 EMA was at entry. " +
               "ON: the stop follows the 50 EMA in the trade's favour and never moves back.")

// ═════════════════════════════════════════════════════════════════════════════
// INPUTS — FILTERS
// ═════════════════════════════════════════════════════════════════════════════
iUseSess    = input.bool(false, "Restrict entries to a session", group = grpFilt)
iSess       = input.session("0800-1700", "Session", group = grpFilt,
     tooltip = "Exchange timezone. London + New York overlap is where XAUUSD actually moves.")
iMaxPerDay  = input.int(0, "Maximum entries per day (0 = no limit)", minval = 0, maxval = 50, group = grpFilt)

// ═════════════════════════════════════════════════════════════════════════════
// INPUTS — SIZING
// ═════════════════════════════════════════════════════════════════════════════
iSizeMode = input.string(SZ_FIXED, "Position sizing", options = [SZ_FIXED, SZ_RISK], group = grpSize)
iFixedQty = input.float(1.0, "Fixed quantity", minval = 0.01, step = 0.01, group = grpSize)
iRiskPct  = input.float(1.0, "Risk per trade (% of equity)", minval = 0.01, maxval = 100, step = 0.1,
     group = grpSize,
     tooltip = "Quantity is derived from the real stop distance, so every trade risks the same % " +
               "regardless of how wide the 50 EMA stop is.")

// ═════════════════════════════════════════════════════════════════════════════
// INPUTS — DISPLAY
// ═════════════════════════════════════════════════════════════════════════════
iShowEmas   = input.bool(true,  "Plot the EMAs and the ribbon",   group = grpDisp)
iShowMarks  = input.bool(true,  "Mark crosses and retests",       group = grpDisp)
iShowLevels = input.bool(true,  "Plot the live stop / target",    group = grpDisp)
iShowDash   = input.bool(true,  "Show the dashboard",             group = grpDisp)
iDashPos    = input.string("Top right", "Dashboard position",
     options = ["Top right", "Top left", "Bottom right", "Bottom left", "Middle right"], group = grpDisp)

// ═════════════════════════════════════════════════════════════════════════════
// HELPERS  (top level — Pine functions can never live inside a block)
// ═════════════════════════════════════════════════════════════════════════════

// Quantity for a trade with the given stop distance, in price points.
f_qty(float stopDist) =>
    float q = 0.0
    if iSizeMode == SZ_FIXED
        q := iFixedQty
    else if stopDist > 0
        float riskCash   = strategy.equity * iRiskPct / 100.0
        float riskPerUnit = stopDist * syminfo.pointvalue
        q := riskPerUnit > 0 ? riskCash / riskPerUnit : 0.0
    math.max(math.round(q * 100) / 100.0, 0.0)

f_tablePos(string s) =>
    switch s
        "Top left"      => position.top_left
        "Bottom right"  => position.bottom_right
        "Bottom left"   => position.bottom_left
        "Middle right"  => position.middle_right
        => position.top_right

f_px(float p) =>
    na(p) ? "—" : str.tostring(p, format.mintick)

// ═════════════════════════════════════════════════════════════════════════════
// CORE SERIES  (every ta.* call is global and unconditional)
// ═════════════════════════════════════════════════════════════════════════════
emaFast = ta.ema(iSrc, iFastLen)
emaSlow = ta.ema(iSrc, iSlowLen)
atrVal  = ta.atr(iAtrLen)

crossUp = ta.crossover(emaFast, emaSlow)
crossDn = ta.crossunder(emaFast, emaSlow)

newDay   = timeframe.change("1D")
sessTime = time(timeframe.period, iSess)          // called every bar, never inside a lazy operand
inSess   = not iUseSess or not na(sessTime)

tfMinutes = timeframe.in_seconds(timeframe.period) / 60.0
tfIs15    = math.abs(tfMinutes - 15.0) < 0.01

// ═════════════════════════════════════════════════════════════════════════════
// SETUP STATE MACHINE
// A cross arms a setup; the setup waits for the retest and can expire or be
// invalidated before it ever fires.
// ═════════════════════════════════════════════════════════════════════════════
var bool  lArmed = false        // long setup armed, waiting for the retest
var int   lCross = na           // bar_index of the arming cross
var float lHigh  = na           // highest high since the cross (pull-away measure)

var bool  sArmed = false
var int   sCross = na
var float sLow   = na

// --- arming / opposite-cross invalidation ---
if crossUp
    lArmed := true
    lCross := bar_index
    lHigh  := high
    sArmed := false
    sCross := na
    sLow   := na

if crossDn
    sArmed := true
    sCross := bar_index
    sLow   := low
    lArmed := false
    lCross := na
    lHigh  := na

// --- running extremes since the cross ---
if lArmed
    lHigh := math.max(nz(lHigh, high), high)
if sArmed
    sLow := math.min(nz(sLow, low), low)

// --- expiry / structural invalidation ---
lStale = lArmed and iMaxBars > 0 and (bar_index - nz(lCross, bar_index)) > iMaxBars
sStale = sArmed and iMaxBars > 0 and (bar_index - nz(sCross, bar_index)) > iMaxBars
lBreak = lArmed and iInvalidSlow and close < emaSlow
sBreak = sArmed and iInvalidSlow and close > emaSlow

if lStale or lBreak
    lArmed := false
if sStale or sBreak
    sArmed := false

// ═════════════════════════════════════════════════════════════════════════════
// RETEST DETECTION
// ═════════════════════════════════════════════════════════════════════════════
lBars  = lArmed ? bar_index - nz(lCross, bar_index) : na
sBars  = sArmed ? bar_index - nz(sCross, bar_index) : na

lPullOk = lArmed and (nz(lHigh, high) - emaFast) >= iPullMult * atrVal
sPullOk = sArmed and (emaFast - nz(sLow, low))   >= iPullMult * atrVal

lAgeOk  = lArmed and nz(lBars, 0) >= iMinBars
sAgeOk  = sArmed and nz(sBars, 0) >= iMinBars

// A retest is a wick back into the 20 EMA while the trend structure still holds.
lTouch = lArmed and lPullOk and lAgeOk and emaFast > emaSlow and low  <= emaFast + iTouchBuf and close > emaSlow
sTouch = sArmed and sPullOk and sAgeOk and emaFast < emaSlow and high >= emaFast - iTouchBuf and close < emaSlow

// Confirmation: the touching bar closes back on the right side of the 20 EMA.
lConf = lTouch and close > emaFast
sConf = sTouch and close < emaFast

longTrigger  = iEntryMode == EM_CONF ? lConf : iEntryMode == EM_TOUCH ? lTouch : false
shortTrigger = iEntryMode == EM_CONF ? sConf : iEntryMode == EM_TOUCH ? sTouch : false

// ═════════════════════════════════════════════════════════════════════════════
// TRADE PERMISSIONS
// ═════════════════════════════════════════════════════════════════════════════
var int tradesToday = 0
if newDay
    tradesToday := 0

flat      = strategy.position_size == 0
barOk     = not iConfirmed or barstate.isconfirmed
dayOk     = iMaxPerDay == 0 or tradesToday < iMaxPerDay
baseOk    = flat and barOk and dayOk and inSess and not na(emaSlow) and not na(atrVal)
longOk    = baseOk and iDir != DIR_SHORT
shortOk   = baseOk and iDir != DIR_LONG

ID_LONG  = "Long"
ID_SHORT = "Short"
ID_LEXIT = "Long exit"
ID_SEXIT = "Short exit"

// pendStop carries the 50 EMA stop from signal time to fill time
var float pendStop = na

// ═════════════════════════════════════════════════════════════════════════════
// ENTRIES
// ═════════════════════════════════════════════════════════════════════════════

// --- market / confirmation modes ---
if longTrigger and longOk
    float stopLvl = emaSlow - iSlBuf
    float dist    = close - stopLvl
    if dist >= iMinStop and (iMaxStop == 0 or dist <= iMaxStop)
        float q = f_qty(dist)
        if q > 0
            pendStop := stopLvl
            strategy.entry(ID_LONG, strategy.long, qty = q, comment = "20/50 retest")

if shortTrigger and shortOk
    float stopLvl = emaSlow + iSlBuf
    float dist    = stopLvl - close
    if dist >= iMinStop and (iMaxStop == 0 or dist <= iMaxStop)
        float q = f_qty(dist)
        if q > 0
            pendStop := stopLvl
            strategy.entry(ID_SHORT, strategy.short, qty = q, comment = "20/50 retest")

// --- resting limit mode: keep an order parked at the 20 EMA while armed ---
// The order is re-placed (same ID = replaced, not stacked) or cancelled on every
// bar, so a parked order never survives the setup that justified it.
if iEntryMode == EM_LIMIT
    float lStopLvl = emaSlow - iSlBuf
    float lDist    = emaFast - lStopLvl
    float lQty     = f_qty(lDist)
    bool  lSized   = lDist >= iMinStop and (iMaxStop == 0 or lDist <= iMaxStop) and lQty > 0
    bool  lRest    = lArmed and lPullOk and lAgeOk and longOk and emaFast > emaSlow and lSized

    if lRest
        pendStop := lStopLvl
        strategy.entry(ID_LONG, strategy.long, qty = lQty, limit = emaFast, comment = "20/50 retest limit")
    else
        strategy.cancel(ID_LONG)

    float sStopLvl = emaSlow + iSlBuf
    float sDist    = sStopLvl - emaFast
    float sQty     = f_qty(sDist)
    bool  sSized   = sDist >= iMinStop and (iMaxStop == 0 or sDist <= iMaxStop) and sQty > 0
    bool  sRest    = sArmed and sPullOk and sAgeOk and shortOk and emaFast < emaSlow and sSized

    if sRest
        pendStop := sStopLvl
        strategy.entry(ID_SHORT, strategy.short, qty = sQty, limit = emaFast, comment = "20/50 retest limit")
    else
        strategy.cancel(ID_SHORT)

// ═════════════════════════════════════════════════════════════════════════════
// EXIT MANAGEMENT
// Levels are built from the ACTUAL fill price, then held as live bracket orders.
// ═════════════════════════════════════════════════════════════════════════════
var float actEntry = na
var float actStop  = na
var float actTp    = na
var float actR     = na

justIn  = strategy.position_size != 0 and nz(strategy.position_size[1], 0) == 0
inTrade = strategy.position_size != 0

if justIn
    actEntry := strategy.position_avg_price
    actStop  := pendStop
    actR     := math.abs(actEntry - nz(actStop, actEntry))
    actTp    := strategy.position_size > 0 ? actEntry + iRR * actR : actEntry - iRR * actR
    tradesToday += 1
    if not iRearm
        lArmed := false
        sArmed := false

// A fill on the wrong side of its own stop (gap through the 50 EMA) has no
// trade left in it — flatten instead of running an inverted bracket.
badFill = justIn and (strategy.position_size > 0 ? actEntry <= nz(actStop, actEntry) : actEntry >= nz(actStop, actEntry))

if inTrade
    if badFill
        strategy.close_all(comment = "invalid stop")
    else
        if strategy.position_size > 0
            if iTrailSlow and not justIn
                actStop := math.max(nz(actStop, emaSlow - iSlBuf), math.min(emaSlow - iSlBuf, close))
            strategy.exit(ID_LEXIT, ID_LONG, stop = actStop, limit = actTp, comment_loss = "SL", comment_profit = "TP")
        else
            if iTrailSlow and not justIn
                actStop := math.min(nz(actStop, emaSlow + iSlBuf), math.max(emaSlow + iSlBuf, close))
            strategy.exit(ID_SEXIT, ID_SHORT, stop = actStop, limit = actTp, comment_loss = "SL", comment_profit = "TP")

// ═════════════════════════════════════════════════════════════════════════════
// ALERTS
// ═════════════════════════════════════════════════════════════════════════════
if justIn and not badFill
    string side = strategy.position_size > 0 ? "BUY" : "SELL"
    alert('{"strategy":"XAU 20/50 retest","action":"' + str.lower(side) +
          '","symbol":"' + syminfo.ticker +
          '","entry":' + str.tostring(actEntry, format.mintick) +
          ',"stop":'   + str.tostring(actStop,  format.mintick) +
          ',"target":' + str.tostring(actTp,    format.mintick) +
          ',"rr":'     + str.tostring(iRR, "#.##") + '}', alert.freq_once_per_bar)

if crossUp and iDir != DIR_SHORT
    alert("XAU 20/50 — bullish cross, watching for the retest of the 20 EMA", alert.freq_once_per_bar)
if crossDn and iDir != DIR_LONG
    alert("XAU 20/50 — bearish cross, watching for the retest of the 20 EMA", alert.freq_once_per_bar)

// ═════════════════════════════════════════════════════════════════════════════
// PLOTS
// ═════════════════════════════════════════════════════════════════════════════
pFast = plot(iShowEmas ? emaFast : na, "EMA fast", color = color.new(color.aqua, 0),   linewidth = 2)
pSlow = plot(iShowEmas ? emaSlow : na, "EMA slow", color = color.new(color.orange, 0), linewidth = 2)
fill(pFast, pSlow, color = emaFast > emaSlow ? color.new(color.teal, 88) : color.new(color.red, 88), title = "Ribbon")

plot(iShowLevels and inTrade ? actStop : na, "Stop",   color = color.new(color.red, 0),   style = plot.style_linebr, linewidth = 1)
plot(iShowLevels and inTrade ? actTp   : na, "Target", color = color.new(color.green, 0), style = plot.style_linebr, linewidth = 1)
plot(iShowLevels and inTrade ? actEntry : na, "Entry", color = color.new(color.gray, 0),  style = plot.style_linebr, linewidth = 1)

plotshape(iShowMarks and crossUp, title = "Bullish cross", style = shape.triangleup,
     location = location.belowbar, color = color.new(color.teal, 0), size = size.tiny)
plotshape(iShowMarks and crossDn, title = "Bearish cross", style = shape.triangledown,
     location = location.abovebar, color = color.new(color.red, 0), size = size.tiny)

plotshape(iShowMarks and lTouch, title = "Long retest", style = shape.circle,
     location = location.belowbar, color = color.new(color.lime, 20), size = size.tiny)
plotshape(iShowMarks and sTouch, title = "Short retest", style = shape.circle,
     location = location.abovebar, color = color.new(color.fuchsia, 20), size = size.tiny)

bgcolor(iShowMarks and (lArmed or sArmed) and not inTrade
     ? color.new(lArmed ? color.teal : color.red, 94) : na, title = "Setup armed")

// ═════════════════════════════════════════════════════════════════════════════
// DASHBOARD
// ═════════════════════════════════════════════════════════════════════════════
var table dash = table.new(f_tablePos(iDashPos), 2, 11,
     bgcolor = color.new(color.black, 20), border_width = 1, border_color = color.new(color.gray, 60))

if iShowDash and barstate.islast
    string state = inTrade
         ? (strategy.position_size > 0 ? "IN LONG" : "IN SHORT")
         : lArmed ? "Long armed — waiting for the 20 EMA retest"
         : sArmed ? "Short armed — waiting for the 20 EMA retest"
         : "Flat — waiting for a 20/50 cross"

    color stateClr = inTrade ? color.yellow : (lArmed ? color.lime : sArmed ? color.orange : color.silver)

    int    nClosed = strategy.closedtrades
    float  winRate = nClosed > 0 ? 100.0 * strategy.wintrades / nClosed : na
    float  pf      = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : na

    table.merge_cells(dash, 0, 0, 1, 0)
    table.cell(dash, 0, 0, "XAU · EMA " + str.tostring(iFastLen) + "/" + str.tostring(iSlowLen) + " retest",
         text_color = color.white, text_size = size.small, bgcolor = color.new(color.blue, 40))

    table.merge_cells(dash, 0, 1, 1, 1)
    table.cell(dash, 0, 1, tfIs15 ? "Timeframe 15m ✓" : "⚠ Chart is " + timeframe.period + ", designed for 15m",
         text_color = tfIs15 ? color.silver : color.orange, text_size = size.tiny)

    table.merge_cells(dash, 0, 2, 1, 2)
    table.cell(dash, 0, 2, state, text_color = stateClr, text_size = size.tiny)

    table.cell(dash, 0, 3, "EMA " + str.tostring(iFastLen), text_color = color.silver, text_size = size.tiny)
    table.cell(dash, 1, 3, f_px(emaFast), text_color = color.aqua, text_size = size.tiny)

    table.cell(dash, 0, 4, "EMA " + str.tostring(iSlowLen), text_color = color.silver, text_size = size.tiny)
    table.cell(dash, 1, 4, f_px(emaSlow), text_color = color.orange, text_size = size.tiny)

    table.cell(dash, 0, 5, "Bars since cross", text_color = color.silver, text_size = size.tiny)
    table.cell(dash, 1, 5, lArmed ? str.tostring(lBars) : sArmed ? str.tostring(sBars) : "—",
         text_color = color.white, text_size = size.tiny)

    table.cell(dash, 0, 6, "Entry", text_color = color.silver, text_size = size.tiny)
    table.cell(dash, 1, 6, inTrade ? f_px(actEntry) : "—", text_color = color.white, text_size = size.tiny)

    table.cell(dash, 0, 7, "Stop (50 EMA)", text_color = color.silver, text_size = size.tiny)
    table.cell(dash, 1, 7, inTrade ? f_px(actStop) + "  (" + str.tostring(actR, "#.##") + " pts)" : "—",
         text_color = color.red, text_size = size.tiny)

    table.cell(dash, 0, 8, "Target (" + str.tostring(iRR, "#.##") + "R)", text_color = color.silver, text_size = size.tiny)
    table.cell(dash, 1, 8, inTrade ? f_px(actTp) : "—", text_color = color.green, text_size = size.tiny)

    table.cell(dash, 0, 9, "Trades · win rate", text_color = color.silver, text_size = size.tiny)
    table.cell(dash, 1, 9, str.tostring(nClosed) + " · " + (na(winRate) ? "—" : str.tostring(winRate, "#.#") + "%"),
         text_color = color.white, text_size = size.tiny)

    table.cell(dash, 0, 10, "Profit factor · net", text_color = color.silver, text_size = size.tiny)
    table.cell(dash, 1, 10, (na(pf) ? "—" : str.tostring(pf, "#.##")) + " · " + str.tostring(strategy.netprofit, "#.#"),
         text_color = strategy.netprofit >= 0 ? color.green : color.red, text_size = size.tiny)
