//@version=6
strategy("Multi-Horizon Momentum Rubric (Strategy + Trend Filters)", shorttitle="MHM Strat+F", overlay=true,
     initial_capital=100000, default_qty_type=strategy.fixed, default_qty_value=1,
     commission_type=strategy.commission.percent, commission_value=0.1, slippage=2,
     process_orders_on_close=false, calc_on_every_tick=false, pyramiding=1000,
     max_lines_count=100, max_labels_count=100)

// ─────────────────────────────────────────────────────────────
// Multi-Horizon Momentum Rubric + trend filters.
//   Base score = sum of sign(close - close[N]) over 4 lookbacks  (-4 … +4)
//   Filters (daily, last completed bar) veto trades against the larger trend:
//     - EMA filter: price vs EMA, or fast EMA vs slow EMA
//     - ADX filter: require a minimum trend strength
//   A blocked direction goes flat (score treated as 0). Sizing is unchanged:
//     weight x target risk / annualised vol x equity, capped at max leverage.
// Note: the base rubric already IS a trend filter, so an EMA on top is partly
// redundant; test whether it improves results across many markets, not one chart.
// ─────────────────────────────────────────────────────────────

GRP_LB  = "Lookbacks"
GRP_VOL = "Volatility"
GRP_POS = "Position sizing"
GRP_FLT = "Trend filters"
GRP_DSP = "Display"

i_basis = input.string("Auto", "Lookback basis", options=["Auto", "Calendar days (7/14/30/60)", "Trading days (5/10/21/42)"], group=GRP_LB,
     tooltip="Auto = calendar days for crypto (24/7), trading-day equivalents otherwise.")
i_weekly = input.bool(true, "Re-evaluate weekly (hold score/vol between weeks)", group=GRP_LB,
     tooltip="Rubric: recompute every week. Off = recompute and rebalance every bar (more turnover, higher costs).")
i_shorts = input.bool(true, "Allow shorts", group=GRP_LB)

i_volMethod = input.string("Mean |daily move| (rubric)", "Volatility method", options=["Mean |daily move| (rubric)", "Std dev of daily returns"], group=GRP_VOL)

i_targetRisk = input.float(10.0, "Target risk (% annual vol of equity)", minval=0.1, step=0.5, group=GRP_POS)
i_scaling = input.string("|Score| / 4 (sheet)", "Score scaling", options=["|Score| / 4 (sheet)", "|Score| raw (guide)"], group=GRP_POS)
i_maxLev = input.float(1.0, "Max position (x equity)", minval=0.1, step=0.1, group=GRP_POS)
i_minTrade = input.float(2.0, "Min rebalance size (% of equity)", minval=0.0, step=0.5, group=GRP_POS)

i_emaMode = input.string("Price vs EMA", "EMA trend filter", options=["Off", "Price vs EMA", "Fast EMA vs Slow EMA"], group=GRP_FLT,
     tooltip="Price vs EMA: longs only above the slow EMA, shorts only below. Fast vs Slow: longs only when fast EMA > slow EMA, shorts when below. Computed on the daily chart.")
i_emaSlow = input.int(200, "Slow EMA length (days)", minval=2, group=GRP_FLT)
i_emaFast = input.int(50, "Fast EMA length (days)", minval=2, group=GRP_FLT, tooltip="Used only in 'Fast EMA vs Slow EMA' mode.")
i_useAdx = input.bool(false, "ADX strength filter", group=GRP_FLT,
     tooltip="Only hold positions when daily ADX is at or above the threshold (i.e. the market is trending). Helps avoid range-bound whipsaw.")
i_adxLen = input.int(14, "ADX length", minval=2, group=GRP_FLT)
i_adxMin = input.float(20.0, "ADX minimum", minval=1.0, step=1.0, group=GRP_FLT)
i_reactFilter = input.bool(true, "Rebalance immediately when a filter changes", group=GRP_FLT,
     tooltip="On: a filter flipping against (or back in favour of) the score triggers an exit/entry right away, instead of waiting for the weekly rebalance.")

i_showTable = input.bool(true, "Show dashboard", group=GRP_DSP)
i_colorBars = input.bool(true, "Color bars by effective score", group=GRP_DSP)
i_showEma = input.bool(true, "Plot EMAs", group=GRP_DSP)

// ── Derived constants ────────────────────────────────────────
useCalendar = i_basis == "Calendar days (7/14/30/60)" or (i_basis == "Auto" and syminfo.type == "crypto")
LB1 = useCalendar ? 7 : 5
LB2 = useCalendar ? 14 : 10
LB3 = useCalendar ? 30 : 21
LB4 = useCalendar ? 60 : 42
VOL_LEN = useCalendar ? 30 : 21
ANN_FACTOR = math.sqrt(useCalendar ? 365.0 : 252.0)

if timeframe.in_seconds() > 86400
    runtime.error("Use a daily or lower chart timeframe.")

// ADX from the last completed daily bar. Defined at top level (functions cannot be nested).
f_adxPrev(int len) =>
    [_dip, _dim, _adx] = ta.dmi(len, len)
    _adx[1]

// ── Daily data: always the last COMPLETED daily bar (no repaint, no lookahead) ──
[c0, cL1, cL2, cL3, cL4, madVol, sdVol] = request.security(syminfo.tickerid, "D",
     [close[1], close[1 + LB1], close[1 + LB2], close[1 + LB3], close[1 + LB4],
      ta.sma(math.abs(close / close[1] - 1.0), VOL_LEN)[1],
      ta.stdev(close / close[1] - 1.0, VOL_LEN)[1]],
     barmerge.gaps_off, barmerge.lookahead_off)

[emaSlow, emaFast] = request.security(syminfo.tickerid, "D",
     [ta.ema(close, i_emaSlow)[1], ta.ema(close, i_emaFast)[1]],
     barmerge.gaps_off, barmerge.lookahead_off)

adxD = request.security(syminfo.tickerid, "D", f_adxPrev(i_adxLen), barmerge.gaps_off, barmerge.lookahead_off)

// ── Base score and volatility ────────────────────────────────
s1 = math.sign(c0 - cL1)
s2 = math.sign(c0 - cL2)
s3 = math.sign(c0 - cL3)
s4 = math.sign(c0 - cL4)
liveScore = s1 + s2 + s3 + s4
liveVol = (i_volMethod == "Std dev of daily returns" ? sdVol : madVol) * ANN_FACTOR

newWeek = timeframe.change("W")
var float heldScore = na
var float heldVol = na
if (newWeek or na(heldScore)) and not na(liveScore) and not na(liveVol)
    heldScore := liveScore
    heldVol := liveVol

baseScore = i_weekly ? heldScore : liveScore
annVol = i_weekly ? heldVol : liveVol

// ── Trend filters (evaluated on every bar from the last completed daily bar) ──
longEmaOk = i_emaMode == "Off" ? true :
     i_emaMode == "Price vs EMA" ? c0 > emaSlow : emaFast > emaSlow
shortEmaOk = i_emaMode == "Off" ? true :
     i_emaMode == "Price vs EMA" ? c0 < emaSlow : emaFast < emaSlow
adxOk = i_useAdx ? (not na(adxD) and adxD >= i_adxMin) : true

// Missing EMA data during warm-up blocks trading rather than letting it through.
emaReady = i_emaMode == "Off" or not na(emaSlow) and (i_emaMode != "Fast EMA vs Slow EMA" or not na(emaFast))

allowLong = longEmaOk and adxOk and emaReady
allowShort = shortEmaOk and adxOk and emaReady and i_shorts

score = na(baseScore) ? na : baseScore > 0 ? (allowLong ? baseScore : 0.0) : baseScore < 0 ? (allowShort ? baseScore : 0.0) : 0.0

// ── Target position ──────────────────────────────────────────
scoreWeight = i_scaling == "|Score| / 4 (sheet)" ? math.abs(score) / 4.0 : math.abs(score)
rawPct = (not na(annVol) and annVol > 0 and not na(score)) ? scoreWeight * (i_targetRisk / 100.0) / annVol : na
targetPct = na(rawPct) ? na : math.min(rawPct, i_maxLev) * math.sign(score)
targetQty = (na(targetPct) or close <= 0) ? na : targetPct * strategy.equity / close

// ── Execution ────────────────────────────────────────────────
targetSignChanged = math.sign(nz(score)) != math.sign(nz(score[1]))
rebalanceNow = ((i_weekly ? newWeek : true) or (i_reactFilter and targetSignChanged)) and not na(targetQty)
delta = na(targetQty) ? 0.0 : targetQty - strategy.position_size
bigEnough = math.abs(delta) * close >= i_minTrade / 100.0 * strategy.equity

if rebalanceNow
    if targetQty == 0.0
        if strategy.position_size != 0.0
            strategy.close_all(comment="Flat")
    else if bigEnough or math.sign(targetQty) != math.sign(strategy.position_size)
        flip = math.sign(targetQty) != math.sign(strategy.position_size) and strategy.position_size != 0.0
        if flip
            strategy.close_all(comment="Flip")
        newDelta = targetQty - (math.sign(targetQty) != math.sign(strategy.position_size) ? 0.0 : strategy.position_size)
        strategy.order("MHM", newDelta > 0 ? strategy.long : strategy.short, math.abs(newDelta),
             comment=str.format("Score {0}", str.tostring(score, "#")))

// ── Visuals ──────────────────────────────────────────────────
scoreColor = score >= 4 ? color.green : score >= 2 ? color.lime : score <= -4 ? color.red : score <= -2 ? color.orange : color.gray
barcolor(i_colorBars and not na(score) ? scoreColor : na)
plot(i_showEma and i_emaMode != "Off" ? emaSlow : na, "Slow EMA (daily)", color=color.new(color.orange, 20), linewidth=2)
plot(i_showEma and i_emaMode == "Fast EMA vs Slow EMA" ? emaFast : na, "Fast EMA (daily)", color=color.new(color.aqua, 20), linewidth=1)
plot(baseScore, "Base score", display=display.data_window)
plot(score, "Effective score (after filters)", display=display.data_window)
plot(targetPct * 100.0, "Target % of equity", display=display.data_window)
plot(annVol * 100.0, "Annualised vol %", display=display.data_window)
plot(adxD, "ADX (daily)", display=display.data_window)

var table tb = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black, 15), border_width=1, border_color=color.new(color.gray, 60))
if barstate.islast and i_showTable
    filterTxt = baseScore > 0 ? (allowLong ? "long OK" : "long BLOCKED") : baseScore < 0 ? (allowShort ? "short OK" : "short BLOCKED") : "n/a"
    table.cell(tb, 0, 0, "Base score", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(tb, 1, 0, na(baseScore) ? "n/a" : (baseScore > 0 ? "+" : "") + str.tostring(int(baseScore)), text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 1, "Filters", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(tb, 1, 1, filterTxt, text_color=(allowLong or allowShort) ? color.lime : color.red, text_size=size.small)
    table.cell(tb, 0, 2, "Effective score", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(tb, 1, 2, na(score) ? "n/a" : (score > 0 ? "+" : "") + str.tostring(int(score)), text_color=scoreColor, text_size=size.normal)
    table.cell(tb, 0, 3, "Ann. vol", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(tb, 1, 3, na(annVol) ? "n/a" : str.tostring(annVol * 100.0, "#.#") + "%", text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 4, "ADX (daily)", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(tb, 1, 4, na(adxD) ? "n/a" : str.tostring(adxD, "#.#"), text_color=i_useAdx ? (adxOk ? color.lime : color.red) : color.gray, text_size=size.small)
    table.cell(tb, 0, 5, "Target position", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(tb, 1, 5, na(targetPct) ? "n/a" : str.tostring(targetPct * 100.0, "#.#") + "% eq", text_color=scoreColor, text_size=size.small)
    table.cell(tb, 0, 6, "Equity", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(tb, 1, 6, str.tostring(strategy.equity, "#,###"), text_color=color.white, text_size=size.small)
    table.cell(tb, 0, 7, "Educational, not advice.", text_color=color.gray, text_size=size.tiny, text_halign=text.align_left)
    table.merge_cells(tb, 0, 7, 1, 7)
