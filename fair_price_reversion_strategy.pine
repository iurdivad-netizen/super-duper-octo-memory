//@version=6
// =============================================================================
// Fair Price Reversion  --  "The Prop Firm Extraction Algorithm"
// =============================================================================
// Mechanical implementation of the deck's system, built for NQ / MNQ index
// futures on an intraday chart (1m or 5m).
//
// THESIS (deck slide 3, "Fair Pricing Theory"): the 9:30 New York open is the
// first fair-auction reference of the day. Opening flow -- stop runs, hedging,
// liquidity imbalances -- displaces price away from that anchor. Those early
// moves are rarely genuine repricings, so the edge is the snap-back TOWARD the
// 9:30 print, not the move away from it.
//
// THE 90-MINUTE WINDOW (slide 4):
//   9:30 - 9:35   Phase 1, "Unfair Continuation". Ride the opening candle's
//                 own direction. In and out. Bail if it stalls.
//   9:35 - 11:00  Phase 2, "Reversion". Trade EXCLUSIVELY back toward the
//                 9:30 baseline, on A / A+ displacement setups.
//   11:00         Hard stop. Flat, no exceptions.
//
// EXECUTION MATHEMATICS (slide 5): 25pt stop / 38pt target = 1:1.52, sized to
// the standard $2,000 trailing drawdown / $3,000 profit target evaluation.
// If the opening candle's range exceeds 25 points the whole day scales to
// 50pt / 76pt, preserving the ratio.
//
// WHAT IS AND IS NOT MECHANISABLE
// The deck is a discretionary playbook. Three of its rules have no objective
// definition and are implemented here as explicit, documented proxies:
//   * "A setup" -> entry candle body strictly larger than the previous body.
//   * "A+ / break of structure" -> body CLOSE beyond the last confirmed pivot,
//     wicks do not count (slide 6 is explicit about this).
//   * "Bailout: stalls, breaks structure, massive opposing wicks" -> a
//     three-condition test (bars-without-progress, opposing BOS, wick-to-body
//     ratio), each separately tunable.
// The unexpected-news re-anchor (slide 9) is a shock-then-consolidation proxy
// and ships DISABLED, because enabling it moves the very baseline every other
// rule is measured against. Turn it on only once you have read what it does.
//
// The multi-account layer of the deck (slide 2, slide 10 -- "distribute
// variance across decentralised accounts") is portfolio construction, not a
// signal. It cannot be backtested inside one strategy and is not modelled.
// What IS modelled is the single-account evaluation constraint it exists to
// survive: the trailing-drawdown / profit-target guard in section 6.
//
// CALIBRATION WARNING: 25/38/50/76 and the 90-minute clock come from the deck,
// not from this repo's data. Re-measure them on NQ before trusting any curve.
// =============================================================================

strategy("Fair Price Reversion (Prop Firm Extraction)", "FPR", overlay = true,
     default_qty_type        = strategy.fixed,
     default_qty_value       = 1,
     initial_capital         = 50000,
     currency                = currency.USD,
     commission_type         = strategy.commission.cash_per_contract,
     commission_value        = 2.50,
     slippage                = 2,
     pyramiding              = 10,
     process_orders_on_close = false,
     calc_on_every_tick      = false,
     max_bars_back           = 5000,
     max_lines_count         = 500,
     max_labels_count        = 500)

// -----------------------------------------------------------------------------
// Constants
// -----------------------------------------------------------------------------
const string GRP_SESS = "1 - Session & fair price anchor"
const string GRP_CONT = "2 - Phase 1: unfair continuation"
const string GRP_REV  = "3 - Phase 2: reversion"
const string GRP_OR   = "3b - Opening range / trend-day filter"
const string GRP_MATH = "4 - Execution mathematics (SL/TP)"
const string GRP_MGMT = "5 - Bailout & trade management"
const string GRP_EVAL = "6 - Evaluation guard"
const string GRP_SIZE = "7 - Position sizing"
const string GRP_NEWS = "8 - News protocol: 8:30 anchor & shock re-anchor"
const string GRP_DISP = "9 - Display"

const string ANCH_OPEN  = "9:30 open price"
const string ANCH_MID   = "Opening candle midpoint"
const string ANCH_CLOSE = "Opening candle close"
const string ANCH_NEWS  = "8:30 news bar open"
const string ANCH_ZONE  = "8:30 post-news consolidation midpoint"
const string ANCH_AUTO  = "Auto: 8:30 on event days, else 9:30 open"

const string PS_AUTO = "Auto-detect from the symbol"
const string PS_MAN  = "Manual"

const string FP_STATIC = "Static anchor (fixed level)"
const string FP_VWAP   = "Anchored VWAP (moving level)"
const string FP_BLEND  = "Midpoint of static anchor and VWAP"

const string VA_RTH    = "9:30 RTH open"
const string VA_NEWS   = "8:30 news bar"
const string VA_GLOBEX = "Globex open (CME daily boundary)"
const string VA_AUTO   = "Auto: 8:30 on event days, else 9:30"

const string SET_A     = "A setups (displacement only)"
const string SET_APLUS = "A+ setups only (displacement + BOS)"
const string SET_BOTH  = "Both A and A+"

const string TP_FIXED = "Fixed points (segmented extraction)"
const string TP_BASE  = "Fair price baseline (full reversion)"
const string TP_NEAR  = "Nearer of fixed / baseline"

const string BAIL_OFF = "Off"
const string BAIL_BE  = "Move stop to breakeven"
const string BAIL_MKT = "Close at market"

const string SIZE_FIX  = "Fixed contracts"
const string SIZE_RISK = "Risk % of equity"

const string SB_EQ   = "Current equity (compounds)"
const string SB_INIT = "Initial capital (fixed)"

const string OR_CT    = "Block counter-trend entries after an OR break"
const string OR_ALL   = "Block all entries after an OR break"
const string OR_WIDTH = "Width cap only (no break logic)"

const string NB_HIST = "Same bar-of-day history (recommended)"
const string NB_ATR  = "Rolling ATR / volume average"

const string HALT_OFF  = "Off"
const string HALT_DAY  = "Halt for the day"
const string HALT_PERM = "Halt permanently"

// -----------------------------------------------------------------------------
// 1 - Session & fair price anchor
// -----------------------------------------------------------------------------
i_sess = input.session("0930-1600", "RTH session", group = GRP_SESS,
     tooltip = "Only the open of this session matters. The strategy never trades past the hard stop below.")
i_tz   = input.string("America/New_York", "Session timezone", group = GRP_SESS)

i_openBars = input.int(1, "Opening candle = first N chart bars", minval = 1, maxval = 30, group = GRP_SESS,
     tooltip = "The deck's 'opening candle'. On a 5m chart leave this at 1 (09:30-09:35). On a 1m chart set 5 to reproduce the same 5-minute candle, or leave it at 1 to trigger a minute after the open.")

i_anchor = input.string(ANCH_OPEN, "Static anchor =", options = [ANCH_OPEN, ANCH_MID, ANCH_CLOSE, ANCH_NEWS, ANCH_ZONE, ANCH_AUTO], group = GRP_SESS,
     tooltip = "Slide 11 marks the 9:30 OPEN as the permanent baseline; that is the deck. The 8:30 options are a DEPARTURE from it -- slide 9 explicitly says scheduled news is priced in and must NOT move the fair price. The argument for overriding the deck: NQ trades 23 hours, so 9:30 is the cash-equity open, not an auction open, and on data days the genuine repricing happened at 8:30. 'Auto' uses the 8:30 anchor only on days where an 8:30 event is actually detected. If the 8:30 data is unavailable (an RTH-only chart) this silently falls back to the 9:30 open and the dashboard says so.")

i_fpMode = input.string(FP_STATIC, "Fair price mode", options = [FP_STATIC, FP_VWAP, FP_BLEND], group = GRP_SESS,
     tooltip = "READ THIS BEFORE SWITCHING TO VWAP. A static anchor is a FIXED target: if price runs 60 points away, the target stays 60 points away. VWAP CHASES price -- it rises as price rises, so by the time you enter, your measured displacement and your reward have both been compressed, and the target keeps walking toward you while you hold. That systematically shrinks the R:R the deck's whole arithmetic depends on. The compensation is that VWAP also refuses to report a huge displacement on a trend day, which is where the static anchor gets you run over. It is a real trade-off, not a free upgrade. If what you want from VWAP is regime awareness, use the VWAP filter below and keep the static target.")

i_vwapAnchor = input.string(VA_AUTO, "VWAP anchored at", options = [VA_RTH, VA_NEWS, VA_GLOBEX, VA_AUTO], group = GRP_SESS,
     tooltip = "The anchor point is most of the answer. A VWAP anchored at 9:30 sits almost exactly on price at 9:35, so it reports near-zero displacement for the first part of the window and no reversion trade can fire. Anchoring at 8:30 carries an hour of post-news volume and is the version that matches the '8:30 is the day's fair price' thesis. Globex-anchored VWAP is dominated by overnight volume and sits far from post-news price on data days. Note the difference between the two 8:30 options: '8:30 news bar' anchors at 8:30 exactly, spike included. 'Auto' cannot -- whether today is an event day is unknown until the measurement window closes -- so on event days it anchors there instead, which also keeps the release spike out of the average.")

i_vwapSrc = input.source(hlc3, "VWAP source", group = GRP_SESS)

i_vwapFilter = input.bool(false, "Require VWAP agreement", group = GRP_SESS,
     tooltip = "Independent of the fair price mode. Only short when price is ALSO above VWAP, only long when it is ALSO below. This is the highest-value use of VWAP in this system: it keeps the static anchor's fixed target while refusing entries where the volume-weighted average has already followed price -- which is what a trend day looks like from the inside.")

i_vwapSlopeMax = input.float(0.0, "Maximum opposing VWAP slope (points, 0 = off)", minval = 0, group = GRP_SESS,
     tooltip = "Refuse to fade into a VWAP that is itself trending hard in the direction you are fading. Measured over the lookback below. This is the direct answer to 'reversion is a regime bet': a steeply rising VWAP means the day is repricing, not oscillating.")
i_vwapSlopeLen = input.int(15, "VWAP slope lookback (bars)", minval = 1, maxval = 200, group = GRP_SESS)

i_tpFreeze = input.bool(true, "Freeze the baseline target at entry", group = GRP_SESS,
     tooltip = "Only matters when the fair price moves (VWAP or blend). On: each leg's baseline target is the fair price as it stood when that leg was entered, so the limit order does not walk. Off: the target tracks the live fair price, which for a rising VWAP under a short means your target rises to meet you. No effect with a static anchor.")

i_psMode = input.string(PS_AUTO, "Point / pip size", options = [PS_AUTO, PS_MAN], group = GRP_SESS,
     tooltip = "THIS IS NOT THE TICK SIZE, and setting it to the tick size would be a silent disaster. NQ's minimum tick is 0.25, but a 'point' -- the unit the deck's 25 and 38 are quoted in -- is 1.0, or four ticks. Set this to 0.25 and every stop becomes four times tighter than intended while the script runs happily. Auto-detect resolves the CONVENTION: 1.0 for index futures, stocks and crypto, 0.0001 for FX pairs, 0.01 for JPY pairs, 0.0001 for anything pip-quoted. The dashboard always shows what it resolved to and why.")
i_ptSizeMan = input.float(1.0, "Manual point size (price units per point)", minval = 0.0000001, step = 0.25, group = GRP_SESS,
     tooltip = "Used only when the mode above is Manual. 1.0 for NQ / MNQ / ES / YM: one index point is one price unit.")

i_hardStop = input.float(90.0, "Hard stop (minutes after the open)", minval = 5, maxval = 390, group = GRP_SESS,
     tooltip = "Slide 4: total session time is capped at 90 minutes. Everything is flat at 11:00 and no new entry is allowed to fill at or after it.")

// -----------------------------------------------------------------------------
// 2 - Phase 1: unfair continuation
// -----------------------------------------------------------------------------
i_useCont      = input.bool(true, "Trade the continuation", group = GRP_CONT)
i_contDeadline = input.float(5.0, "Continuation window (minutes)", minval = 1, maxval = 60, group = GRP_CONT,
     tooltip = "The deck's 09:30-09:35. The trigger is the opening candle's COLOUR, which is only knowable at that candle's close, so the fill lands on the first tick after the window -- 09:35 on a 5m chart, 09:31 on a 1m chart with a 1-bar opening candle. Phase 2 starts on the first bar closing after this. If your opening candle is longer than this window there is no continuation trade at all, by design.")
i_contMinBody  = input.float(0.0, "Minimum opening candle body (points)", minval = 0, group = GRP_CONT,
     tooltip = "Skip the continuation when the opening candle is a doji. 0 disables the filter.")
i_contClose    = input.bool(true, "Close the continuation at the end of phase 1", group = GRP_CONT,
     tooltip = "Slide 4: 'in and out instantly'. Off = let the bracket or the hard stop decide.")

// -----------------------------------------------------------------------------
// 3 - Phase 2: reversion
// -----------------------------------------------------------------------------
i_useRev   = input.bool(true, "Trade the reversion", group = GRP_REV)
i_setup    = input.string(SET_BOTH, "Setup grade required", options = [SET_A, SET_APLUS, SET_BOTH], group = GRP_REV,
     tooltip = "A = displacement body larger than the previous body. A+ = that, plus a body CLOSE through the last pivot. 'Both' takes every A and simply tags the A+ ones.")
i_minDisp  = input.float(25.0, "Minimum displacement from fair price (points)", minval = 0, group = GRP_REV,
     tooltip = "Dead band around the baseline. Price must be at least this far away before there is anything to revert. IMPORTANT: with the 'nearer of fixed / baseline' target, the deck's 1:1.52 only survives when the displacement is at least as large as the take profit. At 25 points of displacement you risk 25 to make 25. Set this to 38 (or your TP) to guarantee the full ratio, at the cost of far fewer trades -- the dashboard's 'R:R here' row shows what you are actually being paid.")
i_minBody  = input.float(0.0, "Minimum entry body (points)", minval = 0, group = GRP_REV,
     tooltip = "Absolute floor on displacement size, on top of the larger-than-previous test. 0 disables.")
i_pivLen   = input.int(2, "Structure pivot length", minval = 1, maxval = 20, group = GRP_REV,
     tooltip = "Bars either side of a swing. A pivot is only confirmed this many bars after it prints -- structure is deliberately lagged so it cannot repaint.")
i_resetStr = input.bool(true, "Reset structure at the session open", group = GRP_REV,
     tooltip = "On = only intraday swings count as structure. Off = carry overnight swings in.")

i_maxLayers   = input.int(3, "Maximum layered entries", minval = 1, maxval = 10, group = GRP_REV,
     tooltip = "Slide 8: 'if price breaks structure in your favour, layer an additional entry'. Each layer carries its own independent bracket.")
i_layerBos    = input.bool(true, "Layers require a break of structure (A+)", group = GRP_REV)
i_layerMinPts = input.float(10.0, "Minimum points between layers", minval = 0, group = GRP_REV,
     tooltip = "A layer must be this much further along toward the baseline than the previous entry. Stops the same displacement being traded twice.")
i_maxTrades   = input.int(10, "Maximum entries per day", minval = 1, maxval = 50, group = GRP_REV,
     tooltip = "Slide 8 runs 10+ per day ACROSS accounts. On one account this is the per-day cap.")
i_allowRev    = input.bool(false, "Allow reversing an open position", group = GRP_REV,
     tooltip = "Off (deck behaviour): an opposite signal is ignored while a position is open.")

// -----------------------------------------------------------------------------
// 3b - Opening range / trend-day filter
//
// The direct answer to the structural problem in Part 3 of the dev notes:
// fading the open works in balance and loses in trend, and the static anchor
// reports its LARGEST displacement on exactly the trend days where reversion is
// least likely. A day that breaks its opening range and holds outside it is the
// definition of the day you must not fade.
//
// Applies to reversion entries only. The phase-1 continuation trades WITH the
// opening flow, so a trend-day filter has no business blocking it -- and it
// fires at 9:35, before any sane opening range has formed.
// -----------------------------------------------------------------------------
i_orUse  = input.bool(false, "Enable the opening range filter", group = GRP_OR,
     tooltip = "Off by default so the deck's own configuration stays the reference run. This is the filter most likely to help; turn it on as a separate test, not alongside everything else.")
i_orMin  = input.float(15.0, "Opening range window (minutes from the open)", minval = 1, maxval = 120, group = GRP_OR,
     tooltip = "15 minutes ends at 9:45 and leaves most of the 90-minute window to trade. The classic 30-minute initial balance ends at 10:00 and costs you a third of the session before the filter can say anything.")
i_orMode = input.string(OR_CT, "When the range breaks", options = [OR_CT, OR_ALL, OR_WIDTH], group = GRP_OR,
     tooltip = "'Block counter-trend' is the precise rule and the one to start with: after an upside break it blocks reversion SHORTS but still allows longs back up to the anchor, because those run with the day rather than against it. 'Block all' kills the day. 'Width cap only' skips the break logic and uses just the width test below.")
i_orHoldBars = input.int(2, "Closes outside the range to confirm a break", minval = 1, maxval = 20, group = GRP_OR,
     tooltip = "One close outside is a probe. Requiring consecutive closes is what separates a break from a wick through the edge.")
i_orSticky = input.bool(false, "Keep the day classified once it breaks", group = GRP_OR,
     tooltip = "Off (recommended): if price closes back INSIDE the range the classification clears. A failed breakout is the best reversion setup there is, and a sticky flag would throw it away. On: once a trend day, always a trend day.")
i_orMaxPts = input.float(0.0, "Skip the day if the range exceeds (points, 0 = off)", minval = 0, group = GRP_OR,
     tooltip = "A separate, blunter test: refuse unusually wide opening ranges outright. Measure your instrument's distribution before picking a number -- an arbitrary cap here is curve fitting.")
i_orWait = input.bool(false, "No reversion entries until the range completes", group = GRP_OR,
     tooltip = "On: nothing trades before 9:45 with the default window, so the filter always has an opinion. Off: entries before the range completes pass unfiltered.")

// -----------------------------------------------------------------------------
// 4 - Execution mathematics
// -----------------------------------------------------------------------------
i_slBase   = input.float(25.0, "Stop loss (points)", minval = 0.25, group = GRP_MATH)
i_tpBase   = input.float(38.0, "Take profit (points)", minval = 0.25, group = GRP_MATH,
     tooltip = "25 / 38 is the deck's 1:1.52 hurdle, chosen against a $2,000 drawdown / $3,000 target evaluation.")
i_volTrig  = input.float(25.0, "Volatility scaling trigger (opening candle range, points)", minval = 0, group = GRP_MATH,
     tooltip = "Slide 5's exception protocol. If the opening candle's high-low exceeds this, the WHOLE day switches to the scaled parameters below.")
i_slScale  = input.float(50.0, "Scaled stop loss (points)", minval = 0.25, group = GRP_MATH)
i_tpScale  = input.float(76.0, "Scaled take profit (points)", minval = 0.25, group = GRP_MATH)
i_tpMode   = input.string(TP_NEAR, "Reversion target", options = [TP_FIXED, TP_BASE, TP_NEAR], group = GRP_MATH,
     tooltip = "Slide 10 is the whole argument: live capital holds all the way back to the baseline, an evaluation segments the same bias into fixed extraction chunks. 'Nearer of the two' is the deck's combination -- take the fixed chunk, unless the baseline arrives first. Continuation trades always use the fixed target; they move away from the baseline, not toward it.")

// -----------------------------------------------------------------------------
// 5 - Bailout & trade management
// -----------------------------------------------------------------------------
i_bailMode   = input.string(BAIL_BE, "Continuation bailout", options = [BAIL_OFF, BAIL_BE, BAIL_MKT], group = GRP_MGMT,
     tooltip = "Slide 7: 'do not hold a stalling continuation trade'. Breakeven keeps the upside if it recovers; market close is the literal reading.")
i_stallBars  = input.int(3, "Stall: bars without progress", minval = 1, maxval = 50, group = GRP_MGMT)
i_stallPts   = input.float(5.0, "Stall: minimum progress required (points)", minval = 0, group = GRP_MGMT,
     tooltip = "If the trade has not moved this far in your favour within the bar count above, it is stalling.")
i_bailBos    = input.bool(true, "Bail on a break of structure against the position", group = GRP_MGMT)
i_wickMult   = input.float(2.0, "Bail on opposing wick / body ratio", minval = 0, step = 0.5, group = GRP_MGMT,
     tooltip = "0 disables. 2.0 = an opposing wick twice the size of the candle body.")
i_wickMinPts = input.float(8.0, "Minimum opposing wick to count (points)", minval = 0, group = GRP_MGMT)
i_revBosExit = input.bool(false, "Exit reversion legs on an opposing break of structure", group = GRP_MGMT,
     tooltip = "Not in the deck -- the deck stops reversion trades at the baseline or at 11:00 only. Off by default.")

// -----------------------------------------------------------------------------
// 6 - Evaluation guard
// -----------------------------------------------------------------------------
i_haltMode  = input.string(HALT_DAY, "Evaluation guard", options = [HALT_OFF, HALT_DAY, HALT_PERM], group = GRP_EVAL,
     tooltip = "'Halt for the day' re-arms the account every session: the drawdown high-water mark and the profit target reset at each open, so the backtest measures many independent evaluation days. 'Halt permanently' simulates ONE account run from the initial capital -- the curve stops dead at the first breach or at the target, which is what an actual evaluation does.")
i_trailDD   = input.float(2000.0, "Trailing drawdown ($)", minval = 0, group = GRP_EVAL,
     tooltip = "Slide 5's standard $2,000. Measured from the equity high-water mark.")
i_ddUnreal  = input.bool(true, "Trailing drawdown counts unrealised profit", group = GRP_EVAL,
     tooltip = "Slide 10: trailing drawdowns 'aggressively punish unrealised floating profits'. On = the high-water mark includes open P&L, which is how most firms actually compute it.")
i_target    = input.float(3000.0, "Profit target ($)", minval = 0, group = GRP_EVAL)
i_dailyLoss = input.float(0.0, "Daily loss limit ($, 0 = off)", minval = 0, group = GRP_EVAL)

// -----------------------------------------------------------------------------
// 7 - Position sizing
// -----------------------------------------------------------------------------
i_sizeMode = input.string(SIZE_FIX, "Sizing", options = [SIZE_FIX, SIZE_RISK], group = GRP_SIZE)
i_qtyFixed = input.int(1, "Contracts per entry", minval = 1, group = GRP_SIZE)
i_riskPct  = input.float(1.0, "Risk per entry (% of equity)", minval = 0.01, step = 0.1, group = GRP_SIZE)
i_sizeBase = input.string(SB_INIT, "Risk % measured against", options = [SB_INIT, SB_EQ], group = GRP_SIZE,
     tooltip = "Only applies to risk-based sizing. Compounding off current equity is INCOMPATIBLE with the evaluation guard: over a profitable multi-year backtest the account grows, position size grows with it, and the fixed $2,000 drawdown becomes breachable in a single trade -- so the guard's pass rate stops meaning anything. A real evaluation account does not compound; you get paid out and it resets. Sizing off initial capital keeps the simulation honest, which is why it is the default.")
i_maxQty   = input.int(10, "Maximum contracts per entry", minval = 1, group = GRP_SIZE,
     tooltip = "Hard cap on the risk-based size. Remember every layer carries the full stop, so N layers risk N times this.")

// -----------------------------------------------------------------------------
// 8 - News protocol: the 8:30 anchor and the shock re-anchor
// -----------------------------------------------------------------------------
i_newsSess     = input.session("0830-0930", "Pre-open / 8:30 news window", group = GRP_NEWS,
     tooltip = "The first bar of this window is the 'news bar'. REQUIRES a chart with extended hours enabled -- on an RTH-only chart no such bar exists and every 8:30 feature silently falls back to the 9:30 anchor.")
i_newsDetect   = input.bool(true, "Detect 8:30 events automatically", group = GRP_NEWS,
     tooltip = "There is no economic calendar in Pine. This detects a VOLATILITY EVENT at 8:30, not a red folder listing: it will catch CPI, NFP, PPI and retail sales, it will also fire on an unrelated 8:30 spike, and it will miss a scheduled release the market shrugs off. Treat it as a proxy and check a handful of flagged days by eye before trusting it.")
i_newsWinMin   = input.float(5.0, "Event measurement window (minutes from 8:30)", minval = 1, maxval = 60, group = GRP_NEWS,
     tooltip = "Measure the reaction over a fixed CLOCK window, not over one chart bar, so a 1m and a 5m chart classify the same day the same way. A CPI move is not finished after sixty seconds.")
i_newsBaseline = input.string(NB_HIST, "Compare against", options = [NB_HIST, NB_ATR], group = GRP_NEWS,
     tooltip = "This choice matters more than the multipliers. A rolling ATR answers 'is this bar unusual for the last 14 bars' -- and the bars right before a release are anomalously QUIET because everyone stands aside, which shrinks the baseline and makes the test fire on ordinary mornings. The bar-of-day history answers the question you actually want: 'is this unusual for an 8:30 window'. It uses the median of recent days so one CPI print cannot poison its own baseline, and falls back to the ATR test until enough days are banked.")
i_newsBaseDays = input.int(20, "Bar-of-day baseline: days of history", minval = 5, maxval = 250, group = GRP_NEWS)
i_newsRangeMult = input.float(3.0, "Event: window range / baseline", minval = 0, step = 0.5, group = GRP_NEWS,
     tooltip = "0 disables the range test. Under the ATR fallback the baseline is scaled by the square root of the window length, since volatility scales with the square root of time, not linearly.")
i_newsVolMult  = input.float(4.0, "Event: window volume / baseline", minval = 0, step = 0.5, group = GRP_NEWS,
     tooltip = "0 disables the volume test. Volume is the more reliable of the two on NQ -- a CPI print routinely does 20x the surrounding minute. Volume scales linearly with the window length.")
i_newsVolLen   = input.int(20, "ATR-fallback volume average length", minval = 2, maxval = 200, group = GRP_NEWS)

i_useReanchor  = input.bool(false, "Enable the unexpected-news re-anchor", group = GRP_NEWS,
     tooltip = "Slide 9. Scheduled 8:30 data is 'priced in' and needs no code -- the baseline stays put. This models the OTHER branch: an unscheduled shock voids the pre-news fair price, and a new consolidation zone becomes the baseline. Off by default because it moves the anchor every other rule is measured against.")
i_shockMult    = input.float(4.0, "Shock: bar range / ATR", minval = 1, step = 0.5, group = GRP_NEWS)
i_atrLen       = input.int(14, "ATR length", minval = 2, group = GRP_NEWS)
i_consolBars   = input.int(5, "Consolidation: bars required", minval = 2, maxval = 60, group = GRP_NEWS)
i_consolMaxPts = input.float(15.0, "Consolidation: maximum zone height (points)", minval = 0.25, group = GRP_NEWS)

// -----------------------------------------------------------------------------
// 9 - Display
// -----------------------------------------------------------------------------
i_showAnchor = input.bool(true,  "Fair price line & dead band", group = GRP_DISP)
i_showPhases = input.bool(true,  "Shade the phases", group = GRP_DISP)
i_showStruct = input.bool(false, "Plot confirmed structure", group = GRP_DISP)
i_showVwap   = input.bool(true,  "Plot anchored VWAP", group = GRP_DISP)
i_showOr     = input.bool(true,  "Plot opening range", group = GRP_DISP)
i_showLabels = input.bool(true,  "Label entries", group = GRP_DISP)
i_showTable  = input.bool(true,  "Dashboard", group = GRP_DISP)
i_showAttr   = input.bool(true,  "Attribution panel", group = GRP_DISP,
     tooltip = "Splits closed-trade results by phase, setup grade, layer, volatility regime, 8:30 event day, day state and displacement size. P&L is str.tostring of strategy.closedtrades.profit(), which matches the per-trade P&L column in the strategy tester's List of Trades.")

// -----------------------------------------------------------------------------
// Point / pip size
//
// syminfo.mintick answers "what is the smallest price increment" and Pine gives
// it away for free. That is NOT the question here. The question is what one unit
// of the deck's 25 and 38 means on this instrument, and that is a market
// CONVENTION, not a fact any built-in reports:
//
//   NQ / ES / YM / RTY   1 point  = 1.0 price   (4 ticks of 0.25)
//   Stocks, crypto       1 point  = 1.0 price
//   EURUSD, GBPUSD       1 pip    = 0.0001      (10 ticks on a 5-decimal feed)
//   USDJPY and JPY pairs 1 pip    = 0.01
//   6E and FX futures    pip-quoted, caught by the mintick test
//
// The FX branch keys off the quote currency rather than off mintick * 10,
// because a 4-decimal feed would make that arithmetic silently wrong.
// -----------------------------------------------------------------------------
float autoPtSize = syminfo.type == "forex" ? (syminfo.currency == "JPY" ? 0.01 : 0.0001) :
     syminfo.type == "stock" ? 1.0 :
     syminfo.mintick <= 0.0001 ? 0.0001 : 1.0
float ptSize = i_psMode == PS_AUTO ? autoPtSize : i_ptSizeMan

// Portability sanity check, shown on the dashboard. The deck's 25 / 38 are NQ
// numbers; expressing them against the daily range is what exposes the fact
// that they do not travel.
float dailyAtr = request.security(syminfo.tickerid, "D", ta.atr(14)[1], barmerge.gaps_off, barmerge.lookahead_off)

// -----------------------------------------------------------------------------
// Timeframe guard
// -----------------------------------------------------------------------------
float tfMin = timeframe.in_seconds(timeframe.period) / 60.0

if barstate.isfirst
    if not timeframe.isintraday
        runtime.error("Fair Price Reversion is an intraday system. Use a 1m or 5m chart.")
    if ptSize < syminfo.mintick
        runtime.error("Point size (" + str.tostring(ptSize) + ") is smaller than this symbol's minimum tick (" + str.tostring(syminfo.mintick) + "). A point cannot be smaller than a tick. Switch the point size to Manual and set it to the unit your stop and target are actually quoted in.")
    if tfMin > i_contDeadline
        runtime.error("Chart timeframe (" + str.tostring(tfMin) + "m) is longer than the continuation window (" + str.tostring(i_contDeadline) + "m), so phase 1 can never resolve. Use a lower timeframe or widen the window.")

// -----------------------------------------------------------------------------
// Helpers
// -----------------------------------------------------------------------------
f_pts(float points) =>
    points * ptSize

f_alertMsg(string tag, int dir, float px, float sl, float tp, float fair) =>
    "FPR " + tag + " " + (dir == 1 ? "LONG" : "SHORT") + " " + syminfo.ticker +
         " @ "  + str.tostring(px,   format.mintick) +
         " SL " + str.tostring(sl,   format.mintick) +
         " TP " + str.tostring(tp,   format.mintick) +
         " | fair " + str.tostring(fair, format.mintick)

f_qty(float slPoints) =>
    float baseEq = i_sizeBase == SB_EQ ? strategy.equity : strategy.initial_capital
    float risked = baseEq * i_riskPct / 100.0
    float perCon = math.max(slPoints * ptSize * syminfo.pointvalue, 0.01)
    float raw    = i_sizeMode == SIZE_RISK ? math.floor(risked / perCon) : i_qtyFixed
    int(math.max(1.0, math.min(raw, i_maxQty)))

// -----------------------------------------------------------------------------
// Unconditional series (must run on every bar)
// -----------------------------------------------------------------------------
float atrVal = ta.atr(i_atrLen)
float ph     = ta.pivothigh(high, i_pivLen, i_pivLen)
float pl     = ta.pivotlow(low,  i_pivLen, i_pivLen)

bool  inSess  = not na(time(timeframe.period, i_sess, i_tz))
bool  newSess = inSess and not inSess[1]

bool  inNews      = not na(time(timeframe.period, i_newsSess, i_tz))
bool  newsBar     = inNews and not inNews[1]
bool  globexStart = timeframe.change("D")
float volAvg      = ta.sma(volume, i_newsVolLen)
int   dayId       = year(time, i_tz) * 10000 + month(time, i_tz) * 100 + dayofmonth(time, i_tz)

// -----------------------------------------------------------------------------
// State
// -----------------------------------------------------------------------------
var float  reanchorPx  = na
var int    sessStartMs = na
var int    sessBars    = 0
var float  openOp      = na
var float  openHi      = na
var float  openLo      = na
var float  openCl      = na
var bool   openDone    = false

var float  swHigh      = na
var float  swLow       = na

var int    entrySeq    = 0
var int    dayTrades   = 0
var float  lastEntryPx = na
var bool   contOpen    = false
var string contId      = ""
var int    contBar     = na
var bool   contBailed  = false

var bool   haltedDay   = false
var bool   haltedPerm  = false
var float  eqPeak      = na
var float  dayStartEq  = na

var bool   reanchorWait = false
var int    consolCount  = 0
var float  consolHi     = na
var float  consolLo     = na
var int    reanchors    = 0

// 8:30 news-bar state. Reset at the news bar, NOT at the RTH open -- 8:30
// precedes 9:30, so a reset at the session open would wipe it before use.
var float  newsOpen    = na
var bool   newsEvent   = false
var int    newsDayId   = na
var float  nwHi        = na
var float  nwLo        = na
var float  nwVol       = 0.0
var bool   nwDone      = false
var int    nwStartMs   = na
var string newsBaseTxt = "--"
var array<float> nrHist = array.new<float>()
var array<float> nvHist = array.new<float>()
var float  nzHi        = na
var float  nzLo        = na
var int    nzCount     = 0
var float  newsZoneMid = na
var bool   nzDone      = false

// Opening range / trend-day classifier.
var float  orHi       = na
var float  orLo       = na
var bool   orDone     = false
var int    orDir      = 0
var int    orOutCount = 0
var int    orLastSide = 0

// Anchored VWAP, accumulated by hand so the reset point is explicit.
var float  cumPV = 0.0
var float  cumV  = 0.0

// Baseline snapshot per leg, so a moving fair price does not drag a live
// target around after the trade is on.
var map<string, float> legFair = map.new<string, float>()

// -----------------------------------------------------------------------------
// Trade attribution
//
// The strategy tester reports one blended equity curve. That is not enough to
// answer any of the questions this system actually raises -- is the edge in the
// continuation or the reversion, do A+ setups beat A setups as slide 6 claims,
// do layers 2 and 3 earn their risk, does the scaled 50/76 regime work, is the
// profit concentrated in balanced days, and does the R:R degradation on small
// displacements show up in the results. Each closed trade is tagged at entry
// and counted into every bucket it belongs to, so one backtest answers all of
// them instead of six.
//
// Bucket layout: 0-2 phase, 3-5 layer, 6-7 volatility regime, 8-9 event day,
// 10-11 day state, 12-13 displacement vs take profit.
// -----------------------------------------------------------------------------
var array<int>   bTr  = array.new<int>(14, 0)
var array<int>   bWin = array.new<int>(14, 0)
var array<float> bPnl = array.new<float>(14, 0.0)
var int   totTr   = 0
var int   totWin  = 0
var float totPnl  = 0.0
var int   ambigTr = 0
var int   lastClosed = 0
var map<string, int> legCode  = map.new<string, int>()
var map<string, int> legAmbig = map.new<string, int>()

f_acc(int idx, float pnl) =>
    bTr.set(idx, bTr.get(idx) + 1)
    bPnl.set(idx, bPnl.get(idx) + pnl)
    if pnl > 0
        bWin.set(idx, bWin.get(idx) + 1)

// phase 0=CONT 1=A 2=A+, layer 0-based capped at 2, then four binary flags.
f_code(int phase, int layer, bool volSc, bool evt, bool trend, bool dispBig) =>
    phase + math.min(layer, 2) * 3 + (volSc ? 9 : 0) + (evt ? 18 : 0) + (trend ? 36 : 0) + (dispBig ? 72 : 0)

f_pct(int part, int whole) =>
    whole <= 0 ? "--" : str.tostring(100.0 * part / whole, "#.#") + "%"

float eqNow = i_ddUnreal ? strategy.equity : strategy.initial_capital + strategy.netprofit

// -----------------------------------------------------------------------------
// Session open: reset everything the day owns
// -----------------------------------------------------------------------------
if newSess
    sessStartMs  := time
    sessBars     := 0
    openOp       := open
    openHi       := high
    openLo       := low
    openCl       := close
    openDone     := false
    reanchorPx   := na
    orHi         := na
    orLo         := na
    orDone       := false
    orDir        := 0
    orOutCount   := 0
    orLastSide   := 0
    dayTrades    := 0
    haltedDay    := false
    dayStartEq   := eqNow
    reanchorWait := false
    consolCount  := 0
    consolHi     := na
    consolLo     := na
    legFair.clear()
    if i_haltMode != HALT_PERM
        eqPeak := eqNow
    if i_resetStr
        swHigh := na
        swLow  := na

// -----------------------------------------------------------------------------
// Opening candle -> anchor + volatility regime
// -----------------------------------------------------------------------------
// openDone is a var that survives the night, so `openDone[1]` on the session's
// first bar reads YESTERDAY's value. openJustDone is a plain per-bar flag and
// is the only safe way to fire the continuation exactly once.
bool openJustDone = false

if inSess
    sessBars += 1
    if sessBars <= i_openBars
        openHi := math.max(nz(openHi, high), high)
        openLo := math.min(nz(openLo, low),  low)
        openCl := close
        if sessBars == i_openBars
            openDone     := true
            openJustDone := true

float openRangePts = na(openHi) or na(openLo) ? na : (openHi - openLo) / ptSize
bool  volScaled    = not na(openRangePts) and openRangePts > i_volTrig
float slPts        = volScaled ? i_slScale : i_slBase
float tpPts        = volScaled ? i_tpScale : i_tpBase

// -----------------------------------------------------------------------------
// Structure
// -----------------------------------------------------------------------------
if not na(ph)
    swHigh := ph
if not na(pl)
    swLow := pl

// -----------------------------------------------------------------------------
// The 8:30 news bar
//
// The deck anchors on 9:30 and slide 9 insists scheduled news must NOT move
// that anchor. The counter-argument is that NQ trades 23 hours a day, so 9:30
// is when cash equities open, not when the futures auction opens -- and on a
// CPI or NFP day the genuine repricing happened an hour earlier, at 8:30, with
// the largest volume print of the session. By 9:30 the market has had an hour
// to find the new equilibrium, which would make the 9:30 print on exactly the
// biggest days the LEAST unfair price of the day, not the most.
//
// Both readings are testable. Neither is assumed: the deck's 9:30 anchor stays
// the default and the 8:30 anchor is opt-in.
// -----------------------------------------------------------------------------
if newsBar
    newsOpen    := open
    newsDayId   := dayId
    newsEvent   := false
    nzHi        := na
    nzLo        := na
    nzCount     := 0
    newsZoneMid := na
    nzDone      := false
    nwStartMs   := time
    nwHi        := high
    nwLo        := low
    nwVol       := nz(volume, 0.0)
    nwDone      := false
else if not nwDone and not na(nwStartMs) and inNews and (time - nwStartMs) / 60000.0 < i_newsWinMin
    nwHi  := math.max(nwHi, high)
    nwLo  := math.min(nwLo, low)
    nwVol += nz(volume, 0.0)

// Evaluate once the measurement window closes. On a chart whose bars are at
// least as long as the window this resolves on the news bar itself.
bool nwJustDone = false

if not nwDone and not na(nwStartMs) and not na(nwHi) and (time - nwStartMs) / 60000.0 + tfMin >= i_newsWinMin
    nwDone     := true
    nwJustDone := true
    float winBars = math.max(1.0, i_newsWinMin / tfMin)
    float wRange  = (nwHi - nwLo) / ptSize
    // Baseline from previous days only -- today is pushed after the test, so a
    // release can never sit in its own baseline.
    float histR = nrHist.size() >= 5 ? nrHist.median() : na
    float histV = nvHist.size() >= 5 ? nvHist.median() : na
    bool  useHist = i_newsBaseline == NB_HIST and not na(histR)
    // Range scales with the square root of time, volume scales linearly.
    float atrR  = na(atrVal) ? na : (atrVal / ptSize) * math.sqrt(winBars)
    float volR  = na(volAvg) ? na : volAvg * winBars
    float rBase = useHist ? histR : atrR
    float vBase = useHist and not na(histV) ? histV : volR
    bool rangeHit = i_newsRangeMult > 0 and not na(rBase) and rBase > 0 and wRange > i_newsRangeMult * rBase
    bool volHit   = i_newsVolMult   > 0 and not na(vBase) and vBase > 0 and nwVol  > i_newsVolMult   * vBase
    newsEvent   := i_newsDetect and (rangeHit or volHit)
    newsBaseTxt := useHist ? "bar-of-day" : i_newsBaseline == NB_HIST ? "ATR (warmup)" : "ATR"
    nrHist.push(wRange)
    nvHist.push(nwVol)
    if nrHist.size() > i_newsBaseDays
        nrHist.shift()
    if nvHist.size() > i_newsBaseDays
        nvHist.shift()

// Post-news consolidation: the first zone of i_consolBars bars no taller than
// i_consolMaxPts. This is slide 9's own mechanic for finding a new fair price,
// applied to the scheduled release rather than only to the unscheduled shock.
if inNews and not newsBar and not nzDone and not na(newsDayId) and newsDayId == dayId
    nzHi := math.max(nz(nzHi, high), high)
    nzLo := math.min(nz(nzLo, low),  low)
    nzCount += 1
    if (nzHi - nzLo) > f_pts(i_consolMaxPts)
        nzCount := 1
        nzHi    := high
        nzLo    := low
    if nzCount >= i_consolBars
        newsZoneMid := (nzHi + nzLo) / 2.0
        nzDone      := true

// Stale-day guard: on a holiday or a half day with no 8:30 bar, yesterday's
// news state must not be read as today's.
bool  newsFresh = not na(newsDayId) and newsDayId == dayId
float newsPx    = newsFresh ? newsOpen    : na
float newsZone  = newsFresh ? newsZoneMid : na
bool  eventDay  = newsFresh and newsEvent

// -----------------------------------------------------------------------------
// Static anchor
// -----------------------------------------------------------------------------
float a930op  = openDone ? openOp : na
float a930mid = openDone ? (openHi + openLo) / 2.0 : na
float a930cl  = openDone ? openCl : na

float anchorRaw = switch i_anchor
    ANCH_MID   => a930mid
    ANCH_CLOSE => a930cl
    ANCH_NEWS  => newsPx
    ANCH_ZONE  => newsZone
    ANCH_AUTO  => eventDay ? newsPx : a930op
    => a930op

// A missing 8:30 anchor (RTH-only chart, no zone formed, holiday) falls back to
// the deck's 9:30 open rather than disabling the day silently.
bool  anchorFellBack = na(anchorRaw) and not na(a930op)
float staticAnchor   = na(anchorRaw) ? a930op : anchorRaw

// -----------------------------------------------------------------------------
// Anchored VWAP
// -----------------------------------------------------------------------------
// VA_NEWS anchors at 8:30 itself. VA_AUTO cannot -- whether today is an event
// day is not known until the measurement window closes -- so it anchors there,
// which also excludes the release spike from the average.
bool vwapReset = i_vwapAnchor == VA_GLOBEX ? globexStart :
     i_vwapAnchor == VA_NEWS ? newsBar :
     (i_vwapAnchor == VA_AUTO and eventDay) ? nwJustDone : newSess

if vwapReset
    cumPV := 0.0
    cumV  := 0.0
float vBar = nz(volume, 0.0)
cumPV += i_vwapSrc * vBar
cumV  += vBar
float vwapNow = cumV > 0 ? cumPV / cumV : na

float vwapSlope = na(vwapNow) or na(vwapNow[i_vwapSlopeLen]) ? na : (vwapNow - vwapNow[i_vwapSlopeLen]) / ptSize

// -----------------------------------------------------------------------------
// News re-anchor protocol (slide 9, unexpected branch)
// -----------------------------------------------------------------------------
bool shockBar = false
if i_useReanchor and inSess and openDone
    shockBar := not na(atrVal) and (high - low) > i_shockMult * atrVal
    if shockBar and not reanchorWait
        reanchorWait := true
        reanchorPx   := na
        consolCount  := 0
        consolHi     := na
        consolLo     := na
        if strategy.position_size != 0
            strategy.close_all(comment = "NEWS SHOCK")
    else if reanchorWait
        consolHi := math.max(nz(consolHi, high), high)
        consolLo := math.min(nz(consolLo, low),  low)
        consolCount += 1
        if (consolHi - consolLo) > f_pts(i_consolMaxPts)
            consolCount := 1
            consolHi    := high
            consolLo    := low
        if consolCount >= i_consolBars
            reanchorPx   := (consolHi + consolLo) / 2.0
            reanchorWait := false
            reanchors    += 1

// -----------------------------------------------------------------------------
// Fair price
//
// A shock re-anchor, once it resolves, overrides everything for the rest of the
// day. Otherwise the fair price is the static anchor, the VWAP, or their
// midpoint. Note what changes with VWAP: fairPrice stops being a level fixed at
// 9:30 and becomes a series that moves every bar, which is why entry brackets
// snapshot it (i_tpFreeze) instead of tracking it.
// -----------------------------------------------------------------------------
float fpDynamic = switch i_fpMode
    FP_VWAP  => vwapNow
    FP_BLEND => na(vwapNow) ? staticAnchor : na(staticAnchor) ? vwapNow : (staticAnchor + vwapNow) / 2.0
    => staticAnchor
float fairPrice = not na(reanchorPx) ? reanchorPx : fpDynamic

bool haveAnchor = not na(fairPrice) and not reanchorWait

// -----------------------------------------------------------------------------
// Clock: minutes from the open, measured at the BAR CLOSE, because that is
// when a signal is generated and therefore when the next-bar fill lands.
// -----------------------------------------------------------------------------
float elapsed = inSess and not na(sessStartMs) ? (time - sessStartMs) / 60000.0 : na
float ce      = na(elapsed) ? -1.0 : elapsed + tfMin

bool inCont     = inSess and openDone and ce >= 0 and ce <= i_contDeadline
bool inRev      = inSess and openDone and ce >  i_contDeadline and ce < i_hardStop
bool atHardStop = inSess and ce >= i_hardStop

// -----------------------------------------------------------------------------
// Opening range and the trend-day classifier
//
// The range is measured on bar CLOSES, on the same clock as everything else, so
// a 1m and a 5m chart bracket the same minutes. At least one bar always goes in,
// even if the window is shorter than a single bar.
// -----------------------------------------------------------------------------
if inSess and ce >= 0 and not orDone
    if na(orHi) or ce <= i_orMin
        orHi := math.max(nz(orHi, high), high)
        orLo := math.min(nz(orLo, low),  low)
    if ce >= i_orMin
        orDone := true

float orWidth = na(orHi) or na(orLo) ? na : (orHi - orLo) / ptSize

if orDone and not na(orHi) and inSess
    int side = close > orHi ? 1 : close < orLo ? -1 : 0
    orOutCount := side == 0 ? 0 : side == orLastSide ? orOutCount + 1 : 1
    orLastSide := side
    if side != 0 and orOutCount >= i_orHoldBars
        orDir := side
    else if side == 0 and not i_orSticky
        // Price closed back inside the range. A failed breakout is the best
        // reversion setup on the board, so the classification clears.
        orDir := 0

bool orWide  = i_orMaxPts > 0 and not na(orWidth) and orWidth > i_orMaxPts
bool orReady = orDone or not i_orWait
bool orBlockShort = i_orUse and (orWide or not orReady
     or (i_orMode == OR_CT and orDir == 1) or (i_orMode == OR_ALL and orDir != 0))
bool orBlockLong  = i_orUse and (orWide or not orReady
     or (i_orMode == OR_CT and orDir == -1) or (i_orMode == OR_ALL and orDir != 0))

// -----------------------------------------------------------------------------
// Candle anatomy (slide 6)
// -----------------------------------------------------------------------------
float body     = math.abs(close - open)
float prevBody = math.abs(close[1] - open[1])
bool  bull     = close > open
bool  bear     = close < open
float upWick   = high - math.max(close, open)
float dnWick   = math.min(close, open) - low

// Diagram 1 -- the A setup: the entry body must exceed the previous body.
bool aSetup = body > prevBody and body >= f_pts(i_minBody)

// Diagram 2 -- the A+ setup: a body CLOSE through the last confirmed pivot.
bool bosDown = not na(swLow)  and close < swLow
bool bosUp   = not na(swHigh) and close > swHigh

// -----------------------------------------------------------------------------
// Reversion bias: 100% committed toward the baseline, never away from it
// -----------------------------------------------------------------------------
float dispPts  = haveAnchor ? (close - fairPrice) / ptSize : na
bool  wantShort = haveAnchor and dispPts >=  i_minDisp
bool  wantLong  = haveAnchor and dispPts <= -i_minDisp

bool gradeShort = switch i_setup
    SET_APLUS => aSetup and bosDown
    => aSetup
bool gradeLong = switch i_setup
    SET_APLUS => aSetup and bosUp
    => aSetup

// VWAP used as a regime gate rather than as a target. Fading price back to a
// static level is a bet that the day is balanced; price sitting the wrong side
// of VWAP, or a VWAP trending hard into the fade, is what a repricing day looks
// like from the inside. Both tests are off by default.
bool vwapKnown  = not na(vwapNow)
bool sideOkShort = not i_vwapFilter or (vwapKnown and close > vwapNow)
bool sideOkLong  = not i_vwapFilter or (vwapKnown and close < vwapNow)
bool slopeOkShort = i_vwapSlopeMax <= 0 or na(vwapSlope) or vwapSlope <=  i_vwapSlopeMax
bool slopeOkLong  = i_vwapSlopeMax <= 0 or na(vwapSlope) or vwapSlope >= -i_vwapSlopeMax

bool revShortSig = i_useRev and inRev and wantShort and bear and gradeShort and sideOkShort and slopeOkShort and not orBlockShort
bool revLongSig  = i_useRev and inRev and wantLong  and bull and gradeLong  and sideOkLong  and slopeOkLong  and not orBlockLong

// -----------------------------------------------------------------------------
// Continuation signal (slide 7): the colour of the opening candle
// -----------------------------------------------------------------------------
int  contDir = na(openCl) or na(openOp) ? 0 : openCl > openOp ? 1 : openCl < openOp ? -1 : 0
bool contSig = i_useCont and inCont and openJustDone and contDir != 0
     and math.abs(openCl - openOp) >= f_pts(i_contMinBody)

// -----------------------------------------------------------------------------
// Position sync -- reset the day's leg bookkeeping whenever we are flat
// -----------------------------------------------------------------------------
if strategy.position_size == 0
    contOpen    := false
    contBailed  := false
    contId      := ""
    lastEntryPx := na

// Derived rather than tracked. A manual counter desynchronises the moment ONE
// leg of a layered position hits its target: position_size is still non-zero so
// nothing resets it, and the freed layer slot can never be reused. Reading the
// engine's own state cannot drift, and makes i_maxLayers a cap on CONCURRENT
// open risk, which is the reading that matters -- i_maxTrades already caps
// total entries per day. Both are accurate at signal time because an entry
// submitted on one bar has filled by the next bar's evaluation, and at most one
// entry is ever submitted per bar.
int posDir     = strategy.position_size > 0 ? 1 : strategy.position_size < 0 ? -1 : 0
int layersOpen = strategy.opentrades

// -----------------------------------------------------------------------------
// Evaluation guard (slide 5 / slide 10)
// -----------------------------------------------------------------------------
eqPeak := na(eqPeak) ? eqNow : math.max(eqPeak, eqNow)
float evalBase = i_haltMode == HALT_PERM ? strategy.initial_capital : nz(dayStartEq, strategy.initial_capital)
float ddFloor  = eqPeak - i_trailDD
float targetEq = evalBase + i_target
float dayPnl   = na(dayStartEq) ? 0.0 : eqNow - dayStartEq

bool ddBreach   = i_trailDD > 0 and eqNow <= ddFloor
bool targetHit  = i_target  > 0 and eqNow >= targetEq
bool dayLossHit = i_dailyLoss > 0 and dayPnl <= -i_dailyLoss

if i_haltMode != HALT_OFF and not haltedPerm and not haltedDay
    if ddBreach or targetHit or dayLossHit
        if i_haltMode == HALT_PERM
            haltedPerm := true
        else
            haltedDay := true
        if strategy.position_size != 0
            strategy.close_all(comment = ddBreach ? "DD BREACH" : targetHit ? "TARGET HIT" : "DAILY LOSS")

// -----------------------------------------------------------------------------
// Hard stop: 11:00, and anything left over outside the session
// -----------------------------------------------------------------------------
if strategy.position_size != 0 and (atHardStop or not inSess)
    strategy.close_all(comment = "HARD STOP")

// End of phase 1 -- the deck does not hold a continuation trade into the
// reversion phase, because the two have opposite biases.
if i_contClose and contOpen and strategy.position_size != 0 and ce > i_contDeadline
    strategy.close(contId, comment = "PHASE END")

// -----------------------------------------------------------------------------
// Continuation bailout (slide 7)
// -----------------------------------------------------------------------------
if i_bailMode != BAIL_OFF and contOpen and not contBailed and strategy.position_size != 0 and not na(contBar)
    float cpx      = strategy.position_avg_price
    int   held     = bar_index - contBar
    float progress = posDir == 1 ? (close - cpx) / ptSize : (cpx - close) / ptSize
    bool  stalling = held >= i_stallBars and progress < i_stallPts
    bool  bosAgainst = i_bailBos and (posDir == 1 ? bosDown : bosUp)
    float wickAgainst = posDir == 1 ? upWick : dnWick
    bool  wickBail = i_wickMult > 0 and wickAgainst >= f_pts(i_wickMinPts)
         and wickAgainst > i_wickMult * math.max(body, syminfo.mintick)
    if stalling or bosAgainst or wickBail
        contBailed := true
        if i_bailMode == BAIL_MKT
            strategy.close(contId, comment = "BAILOUT")

// -----------------------------------------------------------------------------
// Optional: reversion legs exit on an opposing break of structure
// -----------------------------------------------------------------------------
if i_revBosExit and not contOpen and strategy.position_size != 0 and posDir != 0
    if posDir == 1 ? bosDown : bosUp
        strategy.close_all(comment = "STRUCTURE EXIT")

// -----------------------------------------------------------------------------
// Entry permission
// -----------------------------------------------------------------------------
bool canTrade = barstate.isconfirmed and haveAnchor and not haltedDay and not haltedPerm
     and not reanchorWait and dayTrades < i_maxTrades and ce >= 0 and ce < i_hardStop

bool tookLong  = false
bool tookShort = false
string tookTag = ""

// -----------------------------------------------------------------------------
// Phase 1 entry
// -----------------------------------------------------------------------------
if contSig and canTrade and strategy.position_size == 0
    entrySeq += 1
    string cid = "C" + str.tostring(entrySeq)
    int    cqty = f_qty(slPts)
    strategy.entry(cid, contDir == 1 ? strategy.long : strategy.short, qty = cqty, comment = "CONT")
    // Provisional bracket off the signal close so the leg is protected from the
    // fill. Section "bracket refresh" below re-prices it off the real fill.
    float cSl = contDir == 1 ? close - f_pts(slPts) : close + f_pts(slPts)
    float cTp = contDir == 1 ? close + f_pts(tpPts) : close - f_pts(tpPts)
    strategy.exit(cid + "_X", from_entry = cid, stop = cSl, limit = cTp)
    legFair.put(cid, fairPrice)
    legCode.put(cid, f_code(0, layersOpen, volScaled, eventDay, orDir != 0,
         not na(dispPts) and math.abs(dispPts) >= tpPts))
    contId      := cid
    contOpen    := true
    contBar     := bar_index
    contBailed  := false
    lastEntryPx := close
    dayTrades   += 1
    tookLong    := contDir == 1
    tookShort   := contDir == -1
    tookTag     := "CONT"
    if i_showLabels
        label.new(bar_index, contDir == 1 ? low : high, "CONT",
             style = contDir == 1 ? label.style_label_up : label.style_label_down,
             color = color.new(color.gray, 20), textcolor = color.white, size = size.tiny)
    alert(f_alertMsg("CONT", contDir, close, cSl, cTp, fairPrice), alert.freq_once_per_bar_close)

// -----------------------------------------------------------------------------
// Phase 2 entries (including layering)
// -----------------------------------------------------------------------------
int  revDir  = revShortSig ? -1 : revLongSig ? 1 : 0
bool bosThis = revDir == -1 ? bosDown : revDir == 1 ? bosUp : false

if revDir != 0 and canTrade
    bool flat     = strategy.position_size == 0
    bool sameSide = strategy.position_size != 0 and posDir == revDir
    bool oppSide  = strategy.position_size != 0 and posDir != revDir

    bool progressed = na(lastEntryPx) ? true :
         revDir == -1 ? (lastEntryPx - close) >= f_pts(i_layerMinPts)
                      : (close - lastEntryPx) >= f_pts(i_layerMinPts)
    bool canLayer = sameSide and layersOpen < i_maxLayers and progressed
         and (not i_layerBos or bosThis)

    // A reversal is handled by strategy.entry itself: an entry in the opposite
    // direction closes the open legs and opens the new one in the same fill.
    bool canFlip = oppSide and i_allowRev

    if flat or canLayer or canFlip
        entrySeq += 1
        string rid  = "R" + str.tostring(entrySeq)
        int    rqty = f_qty(slPts)
        strategy.entry(rid, revDir == 1 ? strategy.long : strategy.short, qty = rqty,
             comment = bosThis ? "A+" : "A")
        float rSl    = revDir == 1 ? close - f_pts(slPts) : close + f_pts(slPts)
        float rTpFix = revDir == 1 ? close + f_pts(tpPts) : close - f_pts(tpPts)
        float rTp = switch i_tpMode
            TP_BASE => fairPrice
            TP_NEAR => revDir == 1 ? math.min(rTpFix, fairPrice) : math.max(rTpFix, fairPrice)
            => rTpFix
        if (revDir == 1 and rTp <= close) or (revDir == -1 and rTp >= close)
            rTp := rTpFix
        strategy.exit(rid + "_X", from_entry = rid, stop = rSl, limit = rTp)
        legFair.put(rid, fairPrice)
        legCode.put(rid, f_code(bosThis ? 2 : 1, layersOpen, volScaled, eventDay, orDir != 0,
             not na(dispPts) and math.abs(dispPts) >= tpPts))
        if canFlip
            contOpen := false
            contId   := ""
        lastEntryPx := close
        dayTrades   += 1
        tookLong    := revDir == 1
        tookShort   := revDir == -1
        tookTag     := bosThis ? "A+" : "A"
        if i_showLabels
            label.new(bar_index, revDir == 1 ? low : high, tookTag + (layersOpen >= 1 ? " L" + str.tostring(layersOpen + 1) : ""),
                 style = revDir == 1 ? label.style_label_up : label.style_label_down,
                 color = bosThis ? color.new(color.teal, 15) : color.new(color.navy, 25),
                 textcolor = color.white, size = size.tiny)
        alert(f_alertMsg(tookTag, revDir, close, rSl, rTp, fairPrice), alert.freq_once_per_bar_close)

// -----------------------------------------------------------------------------
// Bracket refresh
//
// The provisional brackets above are priced off the SIGNAL close, but the order
// fills at the next bar's open. From the first bar after a fill this loop
// re-prices every live bracket off the trade's ACTUAL entry price, so the
// backtest measures a true 25pt stop rather than a 25pt-from-signal stop. It
// also applies the breakeven bailout and the baseline cap on the target.
// -----------------------------------------------------------------------------
if strategy.opentrades > 0
    for i = 0 to strategy.opentrades - 1
        string eid = strategy.opentrades.entry_id(i)
        float  epx = strategy.opentrades.entry_price(i)
        float  esz = strategy.opentrades.size(i)
        if not na(epx) and esz != 0
            int   ed     = esz > 0 ? 1 : -1
            bool  isCont = str.startswith(eid, "C")
            float xSl    = ed == 1 ? epx - f_pts(slPts) : epx + f_pts(slPts)
            float xTpFix = ed == 1 ? epx + f_pts(tpPts) : epx - f_pts(tpPts)
            float xTp    = xTpFix
            // The fixed component always comes from the ACTUAL fill; only the
            // baseline component is frozen, and only when asked for.
            float legFp  = i_tpFreeze and legFair.contains(eid) ? legFair.get(eid) : fairPrice
            if not isCont and not na(legFp)
                xTp := switch i_tpMode
                    TP_BASE => legFp
                    TP_NEAR => ed == 1 ? math.min(xTpFix, legFp) : math.max(xTpFix, legFp)
                    => xTpFix
                if (ed == 1 and xTp <= epx) or (ed == -1 and xTp >= epx)
                    xTp := xTpFix
            if isCont and contBailed
                xSl := epx
            // Integrity check: a bar whose range covers BOTH the stop and the
            // target has an outcome decided by TradingView's intrabar
            // assumption, not by the data. With a 25pt stop and a 38pt target
            // on a 1m chart that is not rare, and it is the single largest
            // source of backtest optimism in a system like this.
            if (ed == 1 and low <= xSl and high >= xTp) or (ed == -1 and high >= xSl and low <= xTp)
                legAmbig.put(eid, 1)
            strategy.exit(eid + "_X", from_entry = eid, stop = xSl, limit = xTp)

// -----------------------------------------------------------------------------
// Harvest newly closed trades into the attribution buckets
// -----------------------------------------------------------------------------
if strategy.closedtrades > lastClosed
    for k = lastClosed to strategy.closedtrades - 1
        string kid = strategy.closedtrades.entry_id(k)
        float  kpl = strategy.closedtrades.profit(k)
        if legCode.contains(kid)
            int code = legCode.get(kid)
            f_acc(code % 3, kpl)
            f_acc(3  + int(code / 3)  % 3, kpl)
            f_acc(6  + int(code / 9)  % 2, kpl)
            f_acc(8  + int(code / 18) % 2, kpl)
            f_acc(10 + int(code / 36) % 2, kpl)
            f_acc(12 + int(code / 72) % 2, kpl)
            totTr  += 1
            totPnl += kpl
            if kpl > 0
                totWin += 1
            if legAmbig.contains(kid)
                ambigTr += 1
            legCode.remove(kid)
            legAmbig.remove(kid)
            legFair.remove(kid)
    lastClosed := strategy.closedtrades

// -----------------------------------------------------------------------------
// Plots
// -----------------------------------------------------------------------------
bool  showZone = i_showAnchor and inSess and haveAnchor and ce < i_hardStop
float pFair    = showZone ? fairPrice : na
float pUp      = showZone ? fairPrice + f_pts(i_minDisp) : na
float pDn      = showZone ? fairPrice - f_pts(i_minDisp) : na

plot(pFair, "Fair price (9:30)", color = color.new(#1E4C8A, 0), linewidth = 2, style = plot.style_linebr)
pu = plot(pUp, "Dead band upper", color = color.new(#1E4C8A, 65), linewidth = 1, style = plot.style_linebr)
pd = plot(pDn, "Dead band lower", color = color.new(#1E4C8A, 65), linewidth = 1, style = plot.style_linebr)
fill(pu, pd, color = color.new(#1E4C8A, 92), title = "No-trade dead band")

bool orVis = i_showOr and inSess and orDone and not na(orHi) and ce < i_hardStop
plot(orVis ? orHi : na, "Opening range high", color = color.new(#7A5C1E, 25), linewidth = 1, style = plot.style_linebr)
plot(orVis ? orLo : na, "Opening range low",  color = color.new(#7A5C1E, 25), linewidth = 1, style = plot.style_linebr)

plot(i_showVwap and inSess and not na(vwapNow) ? vwapNow : na, "Anchored VWAP", color = color.new(#B8860B, 0), linewidth = 2, style = plot.style_linebr)

plot(i_showStruct and not na(swHigh) ? swHigh : na, "Swing high", color = color.new(color.red, 40), style = plot.style_linebr)
plot(i_showStruct and not na(swLow)  ? swLow  : na, "Swing low",  color = color.new(color.green, 40), style = plot.style_linebr)

bgcolor(i_showPhases and inCont ? color.new(color.orange, 90) : i_showPhases and inRev ? color.new(#1E4C8A, 94) : na, title = "Phase shading")

plotshape(tookLong,  "Long entry",  style = shape.triangleup,   location = location.belowbar, color = color.new(color.teal, 0), size = size.tiny)
plotshape(tookShort, "Short entry", style = shape.triangledown, location = location.abovebar, color = color.new(color.maroon, 0), size = size.tiny)
plotshape(i_showLabels and shockBar, "News shock", style = shape.xcross, location = location.abovebar, color = color.new(color.orange, 0), size = size.tiny)

// -----------------------------------------------------------------------------
// Dashboard
// -----------------------------------------------------------------------------
// The deck advertises a fixed 1:1.52. That only holds while the displacement
// is at least as large as the take profit: under TP_NEAR / TP_BASE the target
// is capped at the baseline, so a trade entered 25 points from fair price
// risks 25 to make 25, not 38. This is the single most important number the
// deck never states, so it gets its own dashboard row.
float effTp = switch i_tpMode
    TP_BASE => na(dispPts) ? na : math.abs(dispPts)
    TP_NEAR => na(dispPts) ? tpPts : math.min(tpPts, math.abs(dispPts))
    => tpPts
float effRR = na(effTp) ? na : effTp / slPts

var table dash = table.new(position.top_right, 2, 21, bgcolor = color.new(color.black, 15), border_width = 1, border_color = color.new(color.gray, 60))

f_row(int r, string k, string v, color vc) =>
    table.cell(dash, 0, r, k, text_color = color.new(color.silver, 0), text_size = size.tiny, text_halign = text.align_left)
    table.cell(dash, 1, r, v, text_color = vc, text_size = size.tiny, text_halign = text.align_right)

if i_showTable and barstate.islast
    string phase = haltedPerm ? "HALTED (run over)" : haltedDay ? "HALTED (day)" :
         reanchorWait ? "AWAITING RE-ANCHOR" : not inSess ? "Outside session" :
         not openDone ? "Opening candle" : inCont ? "1 - Continuation" :
         inRev ? "2 - Reversion" : "Closed (past hard stop)"
    color pc = haltedPerm or haltedDay ? color.red : inRev ? color.aqua : inCont ? color.orange : color.silver

    string anchorLabel = anchorFellBack ? "9:30 open (8:30 n/a)" :
         i_anchor == ANCH_AUTO ? (eventDay ? "8:30 news bar (auto)" : "9:30 open (auto, no event)") : i_anchor
    string fpLabel = i_fpMode == FP_STATIC ? anchorLabel :
         i_fpMode == FP_VWAP ? ("VWAP @ " + (i_vwapAnchor == VA_AUTO ? (eventDay ? "8:30" : "9:30") : i_vwapAnchor)) :
         ("blend: " + anchorLabel + " + VWAP")
    string slopeTxt = na(vwapSlope) ? "" : "  (" + (vwapSlope >= 0 ? "+" : "") + str.tostring(vwapSlope, "#.#") + ")"
    string ptWhy = i_psMode == PS_MAN ? "manual" :
         syminfo.type == "forex" ? (syminfo.currency == "JPY" ? "auto, JPY pip" : "auto, FX pip") :
         syminfo.type == "stock" ? "auto, stock" :
         syminfo.mintick <= 0.0001 ? "auto, pip-quoted" : "auto, 1 pt = 1.0"
    string tickTxt = syminfo.mintick > 0 ?
         "  (" + str.tostring(slPts * ptSize / syminfo.mintick, "#") + " / " + str.tostring(tpPts * ptSize / syminfo.mintick, "#") + " ticks)" : ""
    float slVsAtr = na(dailyAtr) or dailyAtr <= 0 ? na : slPts * ptSize / dailyAtr
    string dayStateTxt = not i_orUse ? "filter off" : orWide ? "WIDE RANGE - skipped" :
         orDir == 1 ? "TRENDING UP - no shorts" : orDir == -1 ? "TRENDING DOWN - no longs" :
         orDone ? "balanced" : "range forming"
    color dayStateCol = not i_orUse ? color.gray : orWide or orDir != 0 ? color.orange : orDone ? color.lime : color.silver

    table.cell(dash, 0, 0, "FAIR PRICE REVERSION", text_color = color.white, text_size = size.tiny, text_halign = text.align_left)
    table.cell(dash, 1, 0, volScaled ? "SCALED" : "STANDARD", text_color = volScaled ? color.orange : color.silver, text_size = size.tiny, text_halign = text.align_right)

    f_row(1,  "Phase", phase, pc)
    f_row(2,  "Fair price", haveAnchor ? str.tostring(fairPrice, format.mintick) : "--", color.white)
    f_row(3,  "Anchor", fpLabel, anchorFellBack ? color.orange : color.silver)
    f_row(4,  "8:30 event", not newsFresh ? "no 8:30 bar" : not nwDone ? "measuring" : (eventDay ? "YES" : "no") + " [" + newsBaseTxt + "]", not newsFresh ? color.orange : eventDay ? color.aqua : color.gray)
    f_row(5,  "VWAP", na(vwapNow) ? "--" : str.tostring(vwapNow, format.mintick) + slopeTxt, color.white)
    f_row(6,  "Displacement", na(dispPts) ? "--" : str.tostring(dispPts, "#.#") + " pt", math.abs(nz(dispPts)) >= i_minDisp ? color.aqua : color.gray)
    f_row(7,  "Opening candle", na(openRangePts) ? "--" : str.tostring(openRangePts, "#.#") + " pt", color.white)
    f_row(8,  "Opening range", not i_orUse ? "off" : na(orWidth) ? "--" : str.tostring(orWidth, "#.#") + " pt" + (orDone ? "" : " (forming)"), orWide ? color.orange : color.white)
    f_row(9,  "Day state", dayStateTxt, dayStateCol)
    f_row(10, "SL / TP", str.tostring(slPts, "#.#") + " / " + str.tostring(tpPts, "#.#") + " pt" + tickTxt, color.white)
    f_row(11, "Point size", str.tostring(ptSize) + "  (" + ptWhy + ", tick " + str.tostring(syminfo.mintick) + ")", i_psMode == PS_MAN ? color.white : color.aqua)
    f_row(12, "SL / daily ATR", na(slVsAtr) ? "--" : str.tostring(slVsAtr, "#.##"), na(slVsAtr) ? color.gray : slVsAtr > 0.35 or slVsAtr < 0.02 ? color.orange : color.white)
    f_row(13, "R:R nominal", str.tostring(tpPts / slPts, "#.00"), color.white)
    f_row(14, "R:R here", na(effRR) ? "--" : str.tostring(effRR, "#.00"), na(effRR) or effRR >= tpPts / slPts ? color.white : color.orange)
    f_row(15, "Entries today", str.tostring(dayTrades) + " / " + str.tostring(i_maxTrades), dayTrades >= i_maxTrades ? color.orange : color.white)
    f_row(16, "Layers open", str.tostring(layersOpen) + " / " + str.tostring(i_maxLayers), color.white)
    f_row(17, "Day P&L", str.tostring(dayPnl, "#.00"), dayPnl >= 0 ? color.lime : color.red)
    f_row(18, "To DD floor", i_trailDD > 0 ? str.tostring(eqNow - ddFloor, "#.00") : "off", eqNow - ddFloor < i_trailDD * 0.25 ? color.red : color.white)
    f_row(19, "To target", i_target > 0 ? str.tostring(targetEq - eqNow, "#.00") : "off", color.white)
    f_row(20, "Re-anchors", i_useReanchor ? str.tostring(reanchors) : "off", color.white)

// -----------------------------------------------------------------------------
// Attribution panel
//
// Read the "Ambiguous" row first. It counts closed trades where a single bar's
// range covered both the stop and the target, so TradingView's intrabar
// assumption picked the winner rather than the data. If that number is a large
// fraction of the total, no other row on this panel means very much until you
// re-run with the bar magnifier on or on a finer timeframe.
// -----------------------------------------------------------------------------
var table attr = table.new(position.bottom_right, 4, 17, bgcolor = color.new(color.black, 15),
     border_width = 1, border_color = color.new(color.gray, 60))

f_attrRow(int r, string lbl, int idx, color lc) =>
    int n = bTr.get(idx)
    float plv = bPnl.get(idx)
    table.cell(attr, 0, r, lbl, text_color = lc, text_size = size.tiny, text_halign = text.align_left)
    table.cell(attr, 1, r, str.tostring(n), text_color = color.white, text_size = size.tiny, text_halign = text.align_right)
    table.cell(attr, 2, r, f_pct(bWin.get(idx), n), text_color = color.silver, text_size = size.tiny, text_halign = text.align_right)
    table.cell(attr, 3, r, n == 0 ? "--" : str.tostring(plv, "#"), text_color = n == 0 ? color.gray : plv >= 0 ? color.lime : color.red, text_size = size.tiny, text_halign = text.align_right)

if i_showAttr and barstate.islast
    table.cell(attr, 0, 0, "ATTRIBUTION", text_color = color.white, text_size = size.tiny, text_halign = text.align_left)
    table.cell(attr, 1, 0, "n", text_color = color.silver, text_size = size.tiny, text_halign = text.align_right)
    table.cell(attr, 2, 0, "win", text_color = color.silver, text_size = size.tiny, text_halign = text.align_right)
    table.cell(attr, 3, 0, "net $", text_color = color.silver, text_size = size.tiny, text_halign = text.align_right)

    table.cell(attr, 0, 1, "TOTAL", text_color = color.white, text_size = size.tiny, text_halign = text.align_left)
    table.cell(attr, 1, 1, str.tostring(totTr), text_color = color.white, text_size = size.tiny, text_halign = text.align_right)
    table.cell(attr, 2, 1, f_pct(totWin, totTr), text_color = color.white, text_size = size.tiny, text_halign = text.align_right)
    table.cell(attr, 3, 1, totTr == 0 ? "--" : str.tostring(totPnl, "#"), text_color = totPnl >= 0 ? color.lime : color.red, text_size = size.tiny, text_halign = text.align_right)

    f_attrRow(2,  "Continuation",   0,  color.silver)
    f_attrRow(3,  "A setups",       1,  color.silver)
    f_attrRow(4,  "A+ setups",      2,  color.aqua)
    f_attrRow(5,  "Layer 1",        3,  color.silver)
    f_attrRow(6,  "Layer 2",        4,  color.silver)
    f_attrRow(7,  "Layer 3+",       5,  color.silver)
    f_attrRow(8,  "Vol standard",   6,  color.silver)
    f_attrRow(9,  "Vol scaled",     7,  color.orange)
    f_attrRow(10, "Normal day",     8,  color.silver)
    f_attrRow(11, "8:30 event day", 9,  color.aqua)
    f_attrRow(12, "Balanced day",   10, color.silver)
    f_attrRow(13, "Trend-day entry",11, color.orange)
    f_attrRow(14, "Disp < TP",      12, color.orange)
    f_attrRow(15, "Disp >= TP",     13, color.silver)

    table.cell(attr, 0, 16, "Ambiguous", text_color = color.orange, text_size = size.tiny, text_halign = text.align_left)
    table.cell(attr, 1, 16, str.tostring(ambigTr), text_color = color.orange, text_size = size.tiny, text_halign = text.align_right)
    table.cell(attr, 2, 16, f_pct(ambigTr, totTr), text_color = color.orange, text_size = size.tiny, text_halign = text.align_right)
    table.cell(attr, 3, 16, "of n", text_color = color.gray, text_size = size.tiny, text_halign = text.align_right)
