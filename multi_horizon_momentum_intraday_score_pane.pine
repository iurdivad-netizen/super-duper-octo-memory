//@version=6
indicator("Multi-Horizon Momentum Score (Intraday / Swing)", shorttitle="MHM Score I/S", overlay=false)

// ─────────────────────────────────────────────────────────────
// SCORE PANE for the intraday / swing adaptation: -4...+4 columns + sizing dashboard.
// Companion of "Multi-Horizon Momentum (Intraday / Swing)" (trend lines on price).
// Create alerts as "Once per bar close".
// ─────────────────────────────────────────────────────────────

GRP_H   = "Horizon"
GRP_LB  = "Lookbacks"
GRP_VOL = "Volatility"
GRP_POS = "Position sizing"

i_mode = input.string("Intraday (chart bars)", "Mode", options=["Intraday (chart bars)", "Swing (daily bars)"], group=GRP_H,
     tooltip="Intraday: everything is measured on the chart's own bars (use a 1m-4h chart). Swing: measured on completed DAILY bars (multi-day to ~1 week holds); works on a daily chart or any lower one.")
i_holdBars = input.int(6, "Intraday: re-evaluate every N bars", minval=1, group=GRP_H,
     tooltip="Intraday mode holds score/vol/size for N chart bars between refreshes (the intraday analogue of the weekly rebalance). 1 = every bar (highest turnover). Rule of thumb: about half of the shortest lookback.")
i_swingHold = input.string("Daily", "Swing: re-evaluate", options=["Every bar", "Daily", "Weekly"], group=GRP_H,
     tooltip="Swing mode refresh schedule. Weekly = the original rubric rhythm.")
i_dConfirmed = input.bool(true, "Swing: use last completed daily bar", group=GRP_H,
     tooltip="On: swing signals use the previous finished daily bar (no repaint, one day of lag). Off: use today's developing daily close.")
i_sessHours = input.float(0.0, "Trading hours per day (0 = auto)", minval=0.0, maxval=24.0, group=GRP_H,
     tooltip="Used only to annualise intraday volatility. Auto: 24h for crypto/forex, 6.5h otherwise. Set ~23 for US index futures.")

i_b1 = input.int(12, "Intraday lookback 1 (bars)", minval=1, group=GRP_LB, inline="b")
i_b2 = input.int(24, "2", minval=1, group=GRP_LB, inline="b")
i_b3 = input.int(48, "3", minval=1, group=GRP_LB, inline="b")
i_b4 = input.int(96, "4", minval=1, group=GRP_LB, inline="b", tooltip="Default 1:2:4:8 spacing (the rubric's 1w/2w/1m/2m ratio). On a 5m chart: 1h / 2h / 4h / 8h.")
i_d1 = input.int(2, "Swing lookback 1 (days)", minval=1, group=GRP_LB, inline="d")
i_d2 = input.int(5, "2", minval=1, group=GRP_LB, inline="d")
i_d3 = input.int(10, "3", minval=1, group=GRP_LB, inline="d")
i_d4 = input.int(20, "4", minval=1, group=GRP_LB, inline="d", tooltip="Swing default 2/5/10/20 days: about 1 day to 1 month, for holds of a few days to a week or two. The original rubric was 5/10/21/42.")

i_bVol = input.int(96, "Intraday vol window (bars)", minval=5, group=GRP_VOL)
i_dVol = input.int(20, "Swing vol window (days)", minval=5, group=GRP_VOL)
i_volMethod = input.string("Mean |move| (rubric)", "Volatility method", options=["Mean |move| (rubric)", "Std dev of returns"], group=GRP_VOL,
     tooltip="Rubric: average absolute % move x sqrt(periods per year). Std dev reads ~25% higher.")

i_portfolio = input.float(100000.0, "Portfolio size ($)", minval=1.0, group=GRP_POS)
i_targetRisk = input.float(10.0, "Target risk (% annual vol of portfolio)", minval=0.1, step=0.5, group=GRP_POS)
i_scaling = input.string("|Score| / 4 (sheet)", "Score scaling", options=["|Score| / 4 (sheet)", "|Score| raw (guide)"], group=GRP_POS)
i_maxLev = input.float(1.0, "Max position (x portfolio)", minval=0.1, step=0.1, group=GRP_POS)

GRP_DSP = "Display"

i_showTable = input.bool(true, "Show dashboard", group=GRP_DSP)
i_tablePos = input.string("Top right", "Dashboard position", options=["Top left", "Top right", "Bottom left", "Bottom right"], group=GRP_DSP)

// ── Mode-dependent constants ─────────────────────────────────
isIntra = i_mode == "Intraday (chart bars)"
LB1 = isIntra ? i_b1 : i_d1
LB2 = isIntra ? i_b2 : i_d2
LB3 = isIntra ? i_b3 : i_d3
LB4 = isIntra ? i_b4 : i_d4
VOL_LEN = isIntra ? i_bVol : i_dVol
UNIT = isIntra ? "b" : "d"
DAYS_PER_YEAR = syminfo.type == "crypto" ? 365.0 : 252.0
HOURS_PER_DAY = i_sessHours > 0.0 ? i_sessHours : (syminfo.type == "crypto" or syminfo.type == "forex" ? 24.0 : 6.5)
BARS_PER_DAY = HOURS_PER_DAY * 3600.0 / timeframe.in_seconds()
ANN_FACTOR = isIntra ? math.sqrt(DAYS_PER_YEAR * BARS_PER_DAY) : math.sqrt(DAYS_PER_YEAR)
OFFSET = i_dConfirmed ? 1 : 0

if isIntra and not timeframe.isintraday
    runtime.error("Intraday mode needs an intraday chart (1m-4h). Use Swing mode on a daily chart.")
if not isIntra and timeframe.in_seconds() > 86400
    runtime.error("Swing mode needs a daily or lower chart timeframe.")

// ── Intraday series: measured on the chart's own bars ────────
retI = close / close[1] - 1.0
iMad = ta.sma(math.abs(retI), VOL_LEN)
iSd = ta.stdev(retI, VOL_LEN)

// ── Swing series: last completed daily bar (no lookahead) ────
[dc0, dL1, dL2, dL3, dL4, dMad, dSd] = request.security(syminfo.tickerid, "D",
     [close[OFFSET], close[OFFSET + LB1], close[OFFSET + LB2], close[OFFSET + LB3], close[OFFSET + LB4],
      ta.sma(math.abs(close / close[1] - 1.0), VOL_LEN)[OFFSET],
      ta.stdev(close / close[1] - 1.0, VOL_LEN)[OFFSET]],
     barmerge.gaps_off, barmerge.lookahead_off)

c0 = isIntra ? close : dc0
cL1 = isIntra ? close[LB1] : dL1
cL2 = isIntra ? close[LB2] : dL2
cL3 = isIntra ? close[LB3] : dL3
cL4 = isIntra ? close[LB4] : dL4
madVol = isIntra ? iMad : dMad
sdVol = isIntra ? iSd : dSd

// ── Score and volatility ─────────────────────────────────────
s1 = math.sign(c0 - cL1)
s2 = math.sign(c0 - cL2)
s3 = math.sign(c0 - cL3)
s4 = math.sign(c0 - cL4)
liveScore = s1 + s2 + s3 + s4
liveVol = (i_volMethod == "Std dev of returns" ? sdVol : madVol) * ANN_FACTOR

// ── Refresh schedule (hold score/vol/size between refreshes) ─
newD = timeframe.change("D")
newW = timeframe.change("W")
idxRefresh = bar_index % i_holdBars == 0
refreshBase = isIntra ? idxRefresh : (i_swingHold == "Every bar" ? true : i_swingHold == "Daily" ? newD : newW)

refresh = refreshBase

var float heldScore = na
var float heldVol = na
if (refresh or na(heldScore)) and not na(liveScore) and not na(liveVol)
    heldScore := liveScore
    heldVol := liveVol

score = heldScore
annVol = heldVol

scoreWeight = i_scaling == "|Score| / 4 (sheet)" ? math.abs(score) / 4.0 : math.abs(score)
rawPct = (not na(annVol) and annVol > 0) ? scoreWeight * (i_targetRisk / 100.0) / annVol : na
posPct = na(rawPct) ? na : math.min(rawPct, i_maxLev)
signedPct = na(posPct) ? na : posPct * math.sign(score)
posValue = signedPct * i_portfolio
posUnits = (na(posValue) or close <= 0) ? na : posValue / close

scoreColor = score >= 4 ? color.new(color.green, 0) :
     score >= 2 ? color.new(color.lime, 30) :
     score <= -4 ? color.new(color.red, 0) :
     score <= -2 ? color.new(color.orange, 30) :
     color.new(color.gray, 40)

fmtScore(float s) =>
    na(s) ? "n/a" : (s > 0 ? "+" : "") + str.tostring(int(s))

tblPos = switch i_tablePos
    "Top left" => position.top_left
    "Bottom left" => position.bottom_left
    "Bottom right" => position.bottom_right
    => position.top_right

plot(score, "Market score", color=scoreColor, style=plot.style_columns)
plot(liveScore, "Live score (unheld)", color=color.new(color.white, 60), style=plot.style_stepline)
plot(signedPct * 100.0, "Position % of portfolio", display=display.data_window)
plot(annVol * 100.0, "Annualised vol %", display=display.data_window)

hline(4, "+4 Full long", color=color.new(color.green, 70), linestyle=hline.style_dotted)
hline(2, "+2 Half long", color=color.new(color.lime, 70), linestyle=hline.style_dotted)
hline(0, "0 Flat", color=color.new(color.gray, 50))
hline(-2, "-2 Half short", color=color.new(color.orange, 70), linestyle=hline.style_dotted)
hline(-4, "-4 Full short", color=color.new(color.red, 70), linestyle=hline.style_dotted)

var table tb = table.new(tblPos, 3, 10, bgcolor=color.new(color.black, 15), border_width=1, border_color=color.new(color.gray, 60))

arrowOf(float s) =>
    na(s) ? "–" : s > 0 ? "▲ +1" : s < 0 ? "▼ -1" : "■ 0"

arrowColor(float s) =>
    na(s) ? color.gray : s > 0 ? color.lime : s < 0 ? color.red : color.gray

ratingOf(float s) =>
    na(s) ? "n/a" : s >= 4 ? "FULL LONG" : s >= 2 ? "HALF LONG" : s <= -4 ? "FULL SHORT" : s <= -2 ? "HALF SHORT" : "FLAT"

retOf(float now, float then) =>
    (na(now) or na(then) or then == 0) ? "n/a" : str.tostring((now / then - 1.0) * 100.0, "#.##") + "%"

if barstate.islast and i_showTable
    table.cell(tb, 0, 0, isIntra ? "Intraday" : "Swing", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(tb, 1, 0, "Change", text_color=color.gray, text_size=size.small)
    table.cell(tb, 2, 0, "Score", text_color=color.gray, text_size=size.small)
    table.cell(tb, 0, 1, str.tostring(LB1) + UNIT, text_color=color.silver, text_size=size.small, text_halign=text.align_left)
    table.cell(tb, 1, 1, retOf(c0, cL1), text_color=color.silver, text_size=size.small)
    table.cell(tb, 2, 1, arrowOf(s1), text_color=arrowColor(s1), text_size=size.small)
    table.cell(tb, 0, 2, str.tostring(LB2) + UNIT, text_color=color.silver, text_size=size.small, text_halign=text.align_left)
    table.cell(tb, 1, 2, retOf(c0, cL2), text_color=color.silver, text_size=size.small)
    table.cell(tb, 2, 2, arrowOf(s2), text_color=arrowColor(s2), text_size=size.small)
    table.cell(tb, 0, 3, str.tostring(LB3) + UNIT, text_color=color.silver, text_size=size.small, text_halign=text.align_left)
    table.cell(tb, 1, 3, retOf(c0, cL3), text_color=color.silver, text_size=size.small)
    table.cell(tb, 2, 3, arrowOf(s3), text_color=arrowColor(s3), text_size=size.small)
    table.cell(tb, 0, 4, str.tostring(LB4) + UNIT, text_color=color.silver, text_size=size.small, text_halign=text.align_left)
    table.cell(tb, 1, 4, retOf(c0, cL4), text_color=color.silver, text_size=size.small)
    table.cell(tb, 2, 4, arrowOf(s4), text_color=arrowColor(s4), text_size=size.small)
    table.cell(tb, 0, 5, "Market score", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(tb, 1, 5, fmtScore(score), text_color=scoreColor, text_size=size.normal)
    table.cell(tb, 2, 5, ratingOf(score), text_color=scoreColor, text_size=size.small)
    table.cell(tb, 0, 6, "Live score", text_color=color.gray, text_size=size.small, text_halign=text.align_left)
    table.cell(tb, 1, 6, fmtScore(liveScore), text_color=color.gray, text_size=size.small)
    table.cell(tb, 2, 6, "held until refresh", text_color=color.gray, text_size=size.tiny)
    table.cell(tb, 0, 7, "Annualised vol", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(tb, 1, 7, na(annVol) ? "n/a" : str.tostring(annVol * 100.0, "#.#") + "%", text_color=color.white, text_size=size.small)
    table.cell(tb, 2, 7, "", text_size=size.small)
    table.cell(tb, 0, 8, "Position", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(tb, 1, 8, na(signedPct) ? "n/a" : str.tostring(signedPct * 100.0, "#.#") + "%", text_color=scoreColor, text_size=size.small)
    table.cell(tb, 2, 8, na(posValue) ? "n/a" : str.tostring(posValue, "#,###") + " $", text_color=scoreColor, text_size=size.small)
    table.cell(tb, 0, 9, "Units", text_color=color.white, text_size=size.small, text_halign=text.align_left)
    table.cell(tb, 1, 9, na(posUnits) ? "n/a" : str.tostring(posUnits, "#,###.##"), text_color=scoreColor, text_size=size.small)
    table.cell(tb, 2, 9, "", text_size=size.small)

// ── Alerts (create as "Once per bar close") ──────────────────
alertcondition(score >= 4 and score[1] < 4, "Full long (+4)", "Momentum score reached +4 (full long)")
alertcondition(score >= 2 and score[1] < 2, "Long bias (>= +2)", "Momentum score reached +2 or higher")
alertcondition(score <= -4 and score[1] > -4, "Full short (-4)", "Momentum score reached -4 (full short)")
alertcondition(score <= -2 and score[1] > -2, "Short bias (<= -2)", "Momentum score reached -2 or lower")
alertcondition(score == 0 and score[1] != 0, "Flat (0)", "Momentum score returned to 0 (stay flat)")
alertcondition(score != score[1] and not na(score[1]), "Score changed", "Momentum score changed")
